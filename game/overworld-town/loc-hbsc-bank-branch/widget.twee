:: Widgets HBSC Bank [widget]
<<widget "hbscOptions">>
    <<if $passage isnot "HBSC Bank Ask Savings Accounts">>
        <<socialiseicon "ask">><<link [[HBSC 저축 계좌에 대해 묻는다 (0:02)|HBSC Bank Ask Savings Accounts]]>><<pass 2>><</link>>
        <br>
    <</if>>
    <<if $passage isnot "HBSC Bank Ask Fixed-Term Deposits">>
        <<socialiseicon "ask">><<link [[HBSC 정기 예금에 대해 묻는다 (0:02)|HBSC Bank Ask Fixed-Term Deposits]]>><<pass 2>><</link>>
        <br>
    <</if>>
    <<if $passage isnot "HBSC Bank Account">>
        <<if $hbsc.account.level lte 0>>
            <<link [[계좌를 개설한다 (0:02)|HBSC Bank Account]]>><<pass 2>><</link>>
            <br>
        <<else>>
            <<if $hbsc.account.level gte 1 and $hbsc.account.level lt 5>>
                <<link [[계좌를 업그레이드한다 (0:02)|HBSC Bank Account]]>><<pass 2>><</link>>
                <br>
            <</if>>
        <</if>>
    <</if>>
    <<if $hbsc.account.level gte 1>>
        <<link [[정기 예금을 맡긴다 (0:02)|HBSC Bank Fixed-Term Deposit]]>><<pass 2>><</link>>
        <br>
    <</if>>
    <<getouticon>><<link [[떠난다|High Street]]>><<endevent>><</link>>
    <br>
<</widget>>