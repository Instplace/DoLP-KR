:: Bike Depot Lock

<<set $outside to 0>><<effects>><<set $lock to 0>>

<<if currentSkillValue('skulduggery') gte $lock>>
	<<if pcAreArmsBound("both")>>
		자물쇠를 딸 수 있을 것 같지만, <span class="blue">팔이 묶여 있지 않다면 말이다.</span>
	<<else>>
		<<wearProp "lockpick">>
		<span class="green">자물쇠는 쉽게 딸 수 있을 것 같다.</span>
		<br><br>

		<<lockicon "pick">><<link [[딴다 (0:10)|Bike Depot]]>><<pass 10>><<crimeUp 5 "trespassing">><</link>><<crime "trespassing">>
	<</if>>
	<br>
<<else>>
	<span class="red">자물쇠는 당신의 실력으로 딸 수 없을 것 같다.</span>
	<<skulduggeryrequired>>
	<br><br>
<</if>>
<<getouticon>><<link [[떠난다|Shopping Centre]]>><</link>>

:: Bike Depot
<<set $outside to 0>><<set $location to "shopping_centre">><<effects>>

당신은 자전거 매장 안에 있다. 자전거 재고가 꽤 많다.
<br><br>
<<if $phase is 5>>
	당신은 수리 키트를 구입했고, 현재 소지량은 <span class="yellow"><<print $bicycle.durability.repair>></span>개가 되었다. <<if $bicycle.durability.repair lt 5>><<print (5 - $bicycle.durability.repair)>>개는 더 들고 다닐 수 있을 것 같다<<else>>더는 들고 다닐 수 없다<</if>>.
	<br><br>
	<<set $phase to 0>>
<<elseif $phase is 4>>
	<<switch $bicycle.quality>>
		<<case 3>>
			<<set _repairAmount to 12000 / 4>>
			<<set $bicycle.durability.current to Math.min($bicycle.durability.current + _repairAmount, 12000)>>
		<<case 2>>
			<<set _repairAmount to 6000 / 4>>
			<<set $bicycle.durability.current to Math.min($bicycle.durability.current + _repairAmount, 6000)>>
		<<case 1>>
			<<set _repairAmount to 3000 / 4>>
			<<set $bicycle.durability.current to Math.min($bicycle.durability.current + _repairAmount, 3000)>>
		<<default>>
	<</switch>>
	당신의 자전거는 정비를 받아 사용 가능 시간이 <<print _repairAmount>>분 회복되었다.
	<br><br>
	<<set $phase to 0>><<unset _repairAmount>>
<<elseif $phase is 3>>
	<<if $bicycle.own>><<set _own to $bicycle.quality>><</if>>
	<<set $bicycle.own to true>><<set $bicycle.quality to 3>><<set $bicycle.durability.current to 12000>>
	<<set $bicycle.durability.max to $bicycle.durability.current>><<set $bicycle.location to "high">>
	<<if _own is not undefined>>
		<span class="gold">직원이 당신의 <<if _own is 2>>중급형<<set $money += 50000>><<else>>기본형<<set $money += 10000>><</if>> 자전거를 보상 판매로 받고 소정의 할인을 해 준다.</span><br>
	<</if>>
	<span class="gold">당신의 고급형 자전거를 구입해 쇼핑센터 밖에 세워 두었다.</span>
	<br><br>
	<<set $phase to 0>>
<<elseif $phase is 2>>
	<<if $bicycle.own>><<set _own to true>><</if>>
	<<set $bicycle.own to true>><<set $bicycle.quality to 2>><<set $bicycle.durability.current to 6000>>
	<<set $bicycle.durability.max to $bicycle.durability.current>><<set $bicycle.location to "high">>
	<<if _own>>
		<span class="gold">직원이 당신의 기본형 자전거를 보상 판매로 받고 소정의 할인을 해 준다.</span><br><<set $money += 10000>>
	<</if>>
	<span class="gold">당신의 중급형 자전거를 구입해 쇼핑센터 밖에 세워 두었다.</span>
	<br><br>
	<<set $phase to 0>>
<<elseif $phase is 1>>
	<<set $bicycle.own to true>><<set $bicycle.quality to 1>><<set $bicycle.durability.current to 3000>>
	<<set $bicycle.durability.max to $bicycle.durability.current>><<set $bicycle.location to "high">>
	<span class="gold">당신의 기본형 자전거를 구입해 쇼핑센터 밖에 세워 두었다.</span>
	<br><br>
	<<set $phase to 0>>
<</if>>

<<if Time.dayState is "night">>
	어둠 속에 당신 혼자 있다.
	<br><br>
<<elseif $exposed gte 1>>
	당신은 자존심을 지키려고 자전거 거치대 뒤에 숨는다.
	<br><br>
<</if>>

<<if $stress gte $stressmax>>
	<<passoutshop>>
<<else>>
	<<if Time.hour is 21>>
		폐점 시간이다. 경비원이 모든 사람을 밖으로 몰아내고 있다.
		<<if $exposed gte 1>>
			경비원이 이 옷차림을 본다면 얼마나 수치스러울지 깨닫고 공황 상태에 빠진다.
		<</if>>
		<br><br>
		<<if $exposed lte 0>>
			<<highicon>><<link [[밖으로 나간다|High Street]]>><</link>>
			<br>
		<<else>>
			<<ind>><<link [["끝날 때까지 숨는다 (1:00)"|Bike Depot]]>><<pass 1 hour>><</link>>
		<</if>>
	<<else>>
		<<if Time.dayState is "night" and Time.hour isnot 21 and !$weekly.theft.bikeDepot>>
			<<shopicon "register">><<link [[계산대를 살펴본다|Bike Depot Register]]>><</link>>
			<br><br>
		<<elseif $exposed lte 0 and Time.dayState isnot "night" and Time.hour isnot 21>>

			<<if $bicycle.durability.repair is undefined && $bicycle.own>><<generate1>><<person1>>
				<<if currentSkillValue('skulduggery') gte 600 || currentSkillValue('science') gte 600>>
					<<set $bicycle.durability.repair to 1>>
					직원용 앞치마를 입은 <<person>>【이가】 당신과 당신의 <<if $bicycle.durability.current < $bicycle.durability.max>>낡아빠진 <</if>>자전거를 잠시 살핀다.
					<br><br>
					"공구 한두 개쯤은 다룰 줄 아는 것 같네요. 작은 수리는 직접 할 수 있게 키트를 팔아 드릴까요? 왜, 비상시에 쓰라고요."
					<br><br>
					<<He>>【은는】 당신이 대답하기도 전에 작은 꾸러미를 건넨다. <span class="green">"이건 서비스로 드리는 거예요. 낭비하지 마세요."</span>
					<br><br>
					<span class="gold">직원들은 당신의 솜씨를 알아보고, 당신에게 공구를 파는 것이 세상에서 가장 큰 실수는 아닐 거라고 판단했다. 그들이 후회하게 만들지는 말자.</span>
					<br><br>
				<<else>>
					직원용 앞치마를 두른 <<person>>【이가】 당신과 당신의 <<if $bicycle.durability.current < $bicycle.durability.max>>낡아빠진 <</if>>자전거를 살펴보는 것이 눈에 들어온다.
					<br>
					<<He>>【은는】 별 감흥이 없어 보이고, 잠시 후 다시 일하러 돌아간다.
					<br>
					<span class="blue">과학을 더 알거나 손재주가 더 좋았다면 그들의 눈에 띌 수도 있었을 것이다.</span>
					<br><br>
				<</if>>
				<<endevent>>
			<</if>>

			<<if $bicycle.quality lt 3 || $bicycle.own is false || !$bicycle.own>>
				<<if $money gte 250000>>
					<<bikeicon>><<link [[고급형 자전거를 구입한다 (£2500 0:05)|Bike Depot]]>><<pass 5>><<set $phase to 3>><<set $money -= 250000>><</link>>
				<<else>>
					<<ind>><span class="red">고급형 자전거를 구입할 £2500이 없다.</span>
				<</if>>
				<br>
			<<elseif $bicycle.quality is 3 && $bicycle.own>>
				<<ind>>이미 고급형 자전거를 가지고 있다.
				<br>
			<</if>>

			<<if $bicycle.quality lt 2 || $bicycle.own is false || !$bicycle.own>>
				<<if $money gte 100000>>
					<<bikeicon>><<link [[중급형 자전거를 구입한다 (£1000 0:05)|Bike Depot]]>><<pass 5>><<set $phase to 2>><<set $money -= 100000>><</link>>
				<<else>>
					<<ind>><span class="red">중급형 자전거를 구입할 £1000이 없다.</span>
				<</if>>
				<br>
			<<elseif $bicycle.quality is 2 && $bicycle.own>>
				<<ind>>이미 중급형 자전거를 가지고 있다.
				<br>
			<</if>>

			<<if !$bicycle.own || $bicycle.own is false>>
				<<if $money gte 50000>>
					<<bikeicon>><<link [[기본형 자전거를 구입한다 (£500 0:05)|Bike Depot]]>><<pass 5>><<set $phase to 1>><<set $money -= 50000>><</link>>
				<<else>>
					<<ind>><span class="red">기본형 자전거를 구입할 £500이 없다.</span>
				<</if>>
				<br>
			<<elseif $bicycle.quality is 1 && $bicycle.own>>
				<<ind>>이미 기본형 자전거를 가지고 있다.
				<br>
			<</if>>

			<<if $bicycle.own>>
				<<if $bicycle.theftEnabled && $bicycle.security lt 0.99>>
					<<lockicon>><<link [[보안 장비를 둘러본다 (0:05)|Bike Depot Security Gear]]>><<pass 5>><</link>>
					<br>
				<<elseif $bicycle.security gte 0.99>>
					<<ind>>구할 수 있는 최고의 보안 장비를 이미 가지고 있다.
					<br>
				<</if>>

				<<if $bicycle.upgrades.length lt 6>>
					<<icon "wrench.png">><<link [[오프로드 업그레이드를 둘러본다 (0:05)|Bike Depot Off-Road]]>><<pass 5>><</link>>
					<br>
				<<elseif $bicycle.upgrades.length gte 6>>
					<<ind>>당신의 자전거는 이 가게가 제공하는 것으로 이미 모두 업그레이드되어 있다.
					<br>
				<</if>>

				<<if $bicycle.durability.current < $bicycle.durability.max>>
					<<if $money gte 20000>>
						<<birdicon "tools">><<link [[자전거를 수리한다 (£200 0:20)|Bike Depot]]>><<pass 20>><<set $bicycle.location to "high">><<set $phase to 4>><</link>><br>
					<<else>>
						<<ind>>자전거를 수리할 £200이 없다.<br>
					<</if>>
				<<elseif $bicycle.durability.current >= $bicycle.durability.max>>
					<<ind>>자전거 상태가 아주 좋아서 수리가 필요 없다.<br>
				<</if>>
					
				<<if $bicycle.durability.repair isnot undefined>>
					<<if $bicycle.durability.repair lt 5>>
						<<if $money gte 5000>>
							<<birdicon "tools">><<link [[수리 키트를 구입한다 (£50 0:05)|Bike Depot]]>><<pass 5>><<set $bicycle.durability.repair++>><<set $money -= 5000>><<set $phase to 5>><</link>>
						<<else>>
							<<ind>>수리 키트를 살 £50이 없다.
						<</if>>
						<br>
					<<else>>
						<<ind>>수리 키트를 더는 들고 다닐 수 없다.
						<br>
					<</if>>
				<</if>>
			<</if>>
			<br>
		<</if>>
		<<getouticon>><<link [[떠난다|Shopping Centre]]>><</link>>
		<br>
	<</if>>
<</if>>

:: Bike Depot Security Gear
<<set $outside to 0>><<set $location to "shopping_centre">><<effects>>

당신은 보안 장비를 둘러본다.
<br><br>

<<if $bicycle.security lt 0.99>>
	<<if $money gte 100000>>
		<<link [[경보기 달린 U형 자물쇠를 구입한다 (£1000)|Bike Depot]]>><<set $money -= 100000>><<set $bicycle.security to 0.99>><</link>><<note "도난 방지율 99.9%">>
	<<else>>
		<span class="red">경보기 달린 U형 자물쇠를 구입할 £1000이 없다.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.99>>
	이미 경보기 달린 U형 자물쇠를 가지고 있다.
	<br>
<</if>>
<<if $bicycle.security lt 0.8>>
	<<if $money gte 75000>>
		<<link [[U형 자물쇠를 구입한다 (£750)|Bike Depot]]>><<set $money -= 75000>><<set $bicycle.security to 0.8>><</link>><<note "도난 방지율 80%">>
	<<else>>
		<span class="red">U형 자물쇠를 구입할 £750이 없다.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.8>>
	이미 U형 자물쇠를 가지고 있다.
	<br>
<</if>>
<<if $bicycle.security lt 0.5>>
	<<if $money gte 50000>>
		<<link [[강화강 중량 체인 자물쇠를 구입한다 (£500)|Bike Depot]]>><<set $money -= 50000>><<set $bicycle.security to 0.5>><</link>><<note "도난 방지율 50%">>
	<<else>>
		<span class="red">강화강 중량 체인 자물쇠를 구입할 £500이 없다.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.5>>
	이미 강화강 중량 체인 자물쇠를 가지고 있다.
	<br>
<</if>>
<<if $bicycle.security lt 0.3>>
	<<if $money gte 25000>>
		<<link [[일반 체인 자물쇠를 구입한다 (£250)|Bike Depot]]>><<set $money -= 25000>><<set $bicycle.security to 0.3>><</link>><<note "도난 방지율 30%">>
	<<else>>
		<span class="red">일반 체인 자물쇠를 구입할 £250이 없다.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.3>>
	이미 일반 체인 자물쇠를 가지고 있다.
	<br>
<</if>>
<<if $bicycle.security lt 0.1>>
	<<if $money gte 10000>>
		<<link [[바퀴 자물쇠를 구입한다 (£100)|Bike Depot]]>><<set $money -= 10000>><<set $bicycle.security to 0.1>><</link>><<note "도난 방지율 10%">>
	<<else>>
		<span class="red">바퀴 자물쇠를 구입할 £100이 없다.</span>
	<</if>>
	<br>
<<elseif $bicycle.security is 0.1>>
	이미 바퀴 자물쇠를 가지고 있다.
	<br>
<</if>>
<br>
<<getouticon>><<link [[뒤로|Bike Depot]]>><</link>>

:: Bike Depot Off-Road
<<set $outside to 0>><<set $location to "shopping_centre">><<effects>>

당신은 오프로드 업그레이드 목록을 둘러본다.
<br><br>

<<if !$bicycle.upgrades.includes("suspension")>>
	<<if $money gte 60000>>
		<<link [[서스펜션 포크 (£600)|$passage]]>><<set $money -= 60000>><<set $bicycle.upgrades.pushUnique("suspension")>><</link>><<note "험지에서 이동 시간 -10%, 내구도 손실 -25%">>
	<<else>>
		<span class="red">서스펜션 포크로 업그레이드할 £600이 없다.</span>
	<</if>>
	<br>
<<else>>
	이미 고품질 에어 포크를 가지고 있다.
	<br>
<</if>>
<<if !$bicycle.upgrades.includes("tyres")>>
	<<if $money gte 10000>>
		<<link [[트레드가 있는 넓은 타이어 (£100)|$passage]]>><<set $money -= 10000>><<set $bicycle.upgrades.pushUnique("tyres")>><</link>><<note "험지에서 이동 시간 -5%, 내구도 손실 -15%">>
	<<else>>
		<span class="red">타이어를 업그레이드할 £100이 없다.</span>
	<</if>>
	<br>
<<else>>
	이미 튼튼한 오프로드 타이어를 가지고 있다.
	<br>
<</if>>
<<if !$bicycle.upgrades.includes("tubeless")>>
	<<if $money gte 10000>>
		<<link [[튜브리스 세팅 (£100)|$passage]]>><<set $money -= 10000>><<set $bicycle.upgrades.pushUnique("tubeless")>><</link>><<note "험지에서 이동 시간 -5%, 내구도 손실 -10%">>
	<<else>>
		<span class="red">튜브리스 세팅으로 업그레이드할 £100이 없다.</span>
	<</if>>
	<br>
<<else>>
	이미 튜브리스 세팅을 갖추고 있다.
	<br>
<</if>>
<<if !$bicycle.upgrades.includes("brakes")>>
	<<if $money gte 30000>>
		<<link [[유압 디스크 브레이크 (£300)|$passage]]>><<set $money -= 30000>><<set $bicycle.upgrades.pushUnique("brakes")>><</link>><<note "험지에서 내구도 손실 -5%">>
	<<else>>
		<span class="red">브레이크를 업그레이드할 £300이 없다.</span>
	<</if>>
	<br>
<<else>>
	이미 유압 디스크 브레이크를 가지고 있다.
	<br>
<</if>>
<<if !$bicycle.upgrades.includes("pedals")>>
	<<if $money gte 8000>>
		<<link [[접지력 좋은 페달 (£80)|$passage]]>><<set $money -= 8000>><<set $bicycle.upgrades.pushUnique("pedals")>><</link>><<note "험지에서 이동 시간 -2.5%, 내구도 손실 -5%">>
	<<else>>
		<span class="red">페달을 업그레이드할 £80이 없다.</span>
	<</if>>
	<br>
<<else>>
	이미 평평하고 접지력 좋은 페달을 가지고 있다.
	<br>
<</if>>
<<if !$bicycle.upgrades.includes("grips")>>
	<<if $money gte 6000>>
		<<link [[인체공학 그립과 바 엔드 (£60)|$passage]]>><<set $money -= 6000>><<set $bicycle.upgrades.pushUnique("grips")>><</link>><<note "험지에서 이동 시간 -2.5%, 내구도 손실 -5%">>
	<<else>>
		<span class="red">핸들 부위를 업그레이드할 £60이 없다.</span>
	<</if>>
	<br>
<<else>>
	이미 인체공학 그립과 바 엔드를 가지고 있다.
	<br>
<</if>>
<br>
<<getouticon>><<link [[뒤로|Bike Depot]]>><</link>>
