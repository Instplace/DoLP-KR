:: Widgets Bike [widget]

<<widget "bike">>
	/* Giant IF/ELSE to account for persistentLocation */
	<<if ($passagePrev is "Bike Ride" && $bicycle.persistentLocation is true) || ($bicycle.persistentLocation is true && ($bicycle.location is $sublocation || $bicycle.location is $location)) || ($bicycle.persistentLocation is false)>>
		<<if $bicycle.durability.repairUse is 1>>
			<span class="yellow">당신은 자전거를 간단히 수리한다. 이제 조금은 더 멀리 갈 수 있을 것이다.</span><br>
			<<set $eventskip to 0>><<set $bicycle.durability.repairUse to 0>>
		<</if>>
		<<if $bicycle.stolen is true>>
			/* Maybe implement some events where you can steal your bike back? */
			<span class="red">당신의 자전거<<if $bicycle.securityStolen is true>>와 보안 장비를<<else>>를<</if>> 도난당했다!</span>
			<<if $bicycle.location is "lake">>
				어떤 학생이 훔쳐 간 게 틀림없다.
			<<elseif $bicycle.location is "residential" or $bicycle.location is "commercial" or $bicycle.location is "industrial">>
				<<if $baileydefeatedchain gte 1>>
					베일리의 부하들이 관련됐을 가능성이 크다.
				<<else>>
					어떤 읍내 사람이 훔쳐 간 게 틀림없다.
				<</if>>
			<<elseif $bicycle.location is "alex_farm">>
				<<if $farm?.aggro gte 20>>
					레미의 부하들이 관련됐을 가능성이 크다.
				<<else>>
					어떤 시골뜨기가 훔쳐 간 게 틀림없다.
				<</if>>
			<</if>><br>
			<span class="blue">그래도 언제든 새로 살 수는 있다...</span>
			<<set $bicycle.stolen to false>><<set $bicycle.securityStolen to false>>
		<<elseif $bicycle.own is true>>
						/* Weird location stuff, will need to be edited if location stuff is ever changed. */
				<<if $location is "town" || $location is "plains" || $location is "forest" || $location is "industrial" || $location is "wolf_cave">>
					<<set $bicycle.location to $sublocation>>
				<<else>>
					<<set $bicycle.location to $location>>
				<</if>>
				<<switch $bicycle.location>>
					<<case "domus" "barb" "danube" "wolf">>
						<<set $bicycle.locationRegion to "residential">>
					<<case "connudatus" "cliff" "high" "starfish" "oxford" "nightingale">>
						<<set $bicycle.locationRegion to "commercial">>
					<<case "mer" "elk" "harvest">>
						<<set $bicycle.locationRegion to "industrial">>
					<<case "cabin" "wolf_cave_yard" "forest">>
						<<set $bicycle.locationRegion to "forest">>
					<<case "lake">><<set $bicycle.locationRegion to "lake">>
					<<case "alex_farm">><<set $bicycle.locationRegion to "alex_farm">>
					<<case "moor">><<set $bicycle.locationRegion to "moor">>
					<<default>>
						<<set _error to 1>>
				<</switch>>
				<<set $bicycle.start to $bicycle.locationRegion>>
			<<if $bicycle.durability.current lte 0>>
				<span class="red">자전거가 고장 났다!</span> 자전거 매장에서 수리받<<if $bicycle.durability.repair isnot undefined>>거나 직접 손보<</if>>기 전까지는 쓸 수 없다.
				<<if $bicycle.durability.repair gt 0>>
					<br>
					<<birdicon "tools">><<link [[응급 수리를 한다|$passage]]>><<set $bicycle.durability.repair-->><<set $bicycle.durability.current to (Math.clamp(($bicycle.durability.current + 500), 500, $bicycle.durability.max))>><<set $bicycle.durability.repairUse to 1>><<set $eventskip to 1>><</link>>
					<br>
				<</if>>
			<<elseif pcAreArmsBound("both")>>
				<<if $worn.feet.type.includes("shackle")>>
					<br>
					<span class="blue">두 팔이 묶이고 발에 족쇄까지 채워져 있어 자전거를 탈 수 없다.</span>
					<br>
				<<else>>
					<br>
					<span class="blue">두 팔이 묶여 있어 자전거를 탈 수 없다.</span>
					<br>
				<</if>>
			<<elseif $worn.feet.type.includes("shackle")>>
				<br>
				<span class="blue">발에 족쇄가 채워져 있어 자전거를 탈 수 없다.</span>
				<br>
			<<elseif !(($exposed gte 1 and Time.dayState is "night") or $exposed is 0)>>
				<span class="blue">너무 노출되어 있어 자전거를 탈 수 없다!</span>
			<<else>>
				<<bikeicon>><<link [[자전거에 올라탄다 (0:01)|Bike]]>><<pass 1>><</link>>
			<</if>>
		<</if>>
		<br>
	<</if>>
<</widget>>

<<widget "cancelBike">>
	<<if $passage isnot "Bike">>
		왜 여기에 있는 거죠? 이건 버그입니다. 프로스트버그에게 항의하십시오.<br>
		<<link [[이 지긋지긋한 곳에서 탈출한다|$passagePrev]]>><<set $eventskip to 1>><</link>>
	<<else>>
		<<bikeicon>><<link [[자전거에서 내린다|$passagePrev]]>><</link>>
		<br><br>
	<</if>>
<</widget>>

<<widget "destinationBike">>
	<<set _destination to _args[0]>>
	<<switch _destination>>
		<<case "domus" "barb" "danube" "wolf" "nightingale" "forestEntrance">>
			<<if $bicycle.location isnot "lake" && $bicycle.location isnot "cabin" && $bicycle.location isnot "wolf_cave_yard" && $bicycle.location isnot "forest">>
				<<if _destination is "nightingale">>
					<<set _destinationRegion to "commercial">>
				<<else>>
					<<set _destinationRegion to "residential">>
				<</if>>
			<<else>>
				<<if _destination is "wolf" || _destination is "nightingale" || _destination is "forestEntrance">>
					<<set _destinationRegion to "forestEntrance">>
				<<else>>
					<<set _destinationRegion to "residential">>
				<</if>>
			<</if>>
		<<case "connudatus" "cliff" "high" "starfish" "oxford">>
			<<set _destinationRegion to "commercial">>
		<<case "mer" "elk" "harvest">>
			<<set _destinationRegion to "industrial">>
		<<case "cabin" "wolf_cave_yard">>
			<<set _destinationRegion to "forest">>
		<<case "lake">><<set _destinationRegion to "lake">>
		<<case "alex_farm">><<set _destinationRegion to "alex_farm">>
		<<case "moor">><<set _destinationRegion to "moor">>
		<<default>>
			<<set _error to 1>>
	<</switch>>
	<<run bikeTime(_destinationRegion)>>
	<<if _error isnot undefined>>
		<<unset _error>>
		<<bikeError>>
	<<else>>
		<<if $bicycle.roughTerrain gt 0>>
			<<set _roughTerrainModifierDurability to ($bicycle.roughTerrain * 2)>>
			<<if $bicycle.upgrades.suspension>><<set _roughTerrainModifierDurability *= 0.75>><</if>>
			<<if $bicycle.upgrades.tyres>><<set _roughTerrainModifierDurability *= 0.85>><</if>>
			<<if $bicycle.upgrades.tubeless>><<set _roughTerrainModifierDurability *= 0.9>><</if>>
			<<if $bicycle.upgrades.brakes>><<set _roughTerrainModifierDurability *= 0.95>><</if>>
			<<if $bicycle.upgrades.pedals>><<set _roughTerrainModifierDurability *= 0.95>><</if>>
			<<if $bicycle.upgrades.grips>><<set _roughTerrainModifierDurability *= 0.95>><</if>>
		<<else>>
			<<set _roughTerrainModifierDurability to 0>>
		<</if>>
		<<if $bicycle.durability.current gte ($bicycle.time + _roughTerrainModifierDurability)>>
		<<set _travelInterrupt to false>>
		<<set $bicycle.durability.current to Math.round(Math.max($bicycle.durability.current - ($bicycle.time + _roughTerrainModifierDurability), 0))>>
		<<set $bicycle.location to _destination>>
		/* The numbers for stat gains/debuffs are arbitrary... For the amount of athletics and physique you gain the tiredness should be comparable. Currently adjusted to compare to running on the harvest road */
		<<set $bicycle.gains.fatigue to Math.round(($bicycle.time + $bicycle.roughTerrain) / 9)>><<set $bicycle.gains.athletics to Math.round($bicycle.time / 12)>><<set $bicycle.gains.physique to Math.round(($bicycle.time + $bicycle.roughTerrain) / 15)>>
		<<else>>
			<<set $bicycle.durability.current to 0>>
			<<set _travelInterrupt to true>>
		<</if>>
	<</if>>
	<<set $eventskip to 1>>
	<<switch _travelInterrupt>>
		<<case false>>
			<<switch _destination>>
				<<case "nightingale">>
				곧 병원이 시야에 들어온다.<br><br><<bikeGains>>
					<<nightingaleicon>><<link [[목적지에 도착한다.|Nightingale Street]]>><</link>>
				<<case "domus">>
				곧 풍경이 바뀌고, 주변 건물이 낯익은 주택들로 변한다.<br><br><<bikeGains>>
					<<domusicon>><<link [[목적지에 도착한다.|Domus Street]]>><</link>>
				<<case "elk">>
				곧 다가오는 굴뚝들의 매캐한 냄새가 코를 채운다.<br><br><<bikeGains>>
					<<elkicon>><<link [[목적지에 도착한다.|Elk Street]]>><</link>>
				<<case "high">>
				곧 풍경이 바뀌고, 주변 건물이 슈퍼마켓 간판과 사무용 건물 로고로 환해진다.<br><br><<bikeGains>>
					<<highicon>><<link [[목적지에 도착한다.|High Street]]>><</link>>
				<<case "starfish">>
				곧 바다의 신선한 소금 냄새가 난다.<br><br><<bikeGains>>
					<<starfishicon>><<link [[목적지에 도착한다.|Starfish Street]]>><</link>>
				<<case "barb">>
				곧 우뚝 솟은 아파트 단지가 당신을 둘러싼다.<br><br><<bikeGains>>
					<<barbicon>><<link [[목적지에 도착한다.|Barb Street]]>><</link>>
				<<case "connudatus">>
				곧 거리가 노점과 식당가로 바뀐다.<br><br><<bikeGains>>
					<<connudatusicon>><<link [[목적지에 도착한다.|Connudatus Street]]>><</link>>
				<<case "wolf">>
				곧 숲 경계 너머로 신전이 모습을 드러낸다.<br><br><<bikeGains>>
					<<wolficon>><<link [[목적지에 도착한다.|Wolf Street]]>><</link>>
				<<case "harvest">>
				곧 마을이 그 너머 평원으로 스며드는 경계가 보인다.<br><br><<bikeGains>>
					<<harvesticon>><<link [[목적지에 도착한다.|Harvest Street]]>><</link>>
				<<case "oxford">>
				곧 학교의 쇠로 만든 울타리가 시야에 들어온다.<br><br><<bikeGains>>
					<<oxfordicon>><<link [[목적지에 도착한다.|Oxford Street]]>><</link>>
				<<case "danube">>
				곧 풍경이 넓은 잔디밭과 위풍당당한 저택들로 매끄럽게 바뀐다.<br><br><<bikeGains>>
					<<danubeicon>><<link [[목적지에 도착한다.|Danube Street]]>><</link>>
				<<case "mer">>
				곧 부두가 시야에 들어오고, 바다 소리와 삐걱대는 배 소리가 귀를 채운다.<br><br><<bikeGains>>
					<<mericon>><<link [[목적지에 도착한다.|Mer Street]]>><</link>>
				<<case "cliff">>
				곧 카페가 눈에 들어온다.<br><br><<bikeGains>>
					<<clifficon>><<link [[목적지에 도착한다.|Cliff Street]]>><</link>>
				<<case "lake">>
				곧 나무 숲이 끊기며 호숫가가 모습을 드러낸다.<br><br><<bikeGains>>
					<<lakeicon>><<link [[목적지에 도착한다.|Lake Shore]]>><</link>>
				<<case "alex_farm">>
				곧 풍경이 바뀌며 평원이 낯익은 농장의 모습에 자리를 내준다.<br><br><<bikeGains>>
					<<farmicon>><<link [[목적지에 도착한다.|Farmland]]>><</link>>
				<<case "forestEntrance">>
				곧 숲 외곽에 닿고, 숲속 상점의 숨겨진 지붕이 시야에 들어온다.<br><br><<bikeGains>>
					<<shopicon "forest">><<link [[목적지에 도착한다.|Forest]]>><<set $forest to 0>><<set $bicycle.location to "forest">><</link>>
				<<case "cabin">>
				곧 에덴의 난로에서 피어오르는 연기 냄새가 나고, 나무들 사이로 오두막 앞 빈터가 열린다.<br><br><<bikeGains>>
				<<if $edenFluidsCheck is "cleanLeave" and ($goocount + $semencount gte 10) and Time.hour gte 7 or $edenFluidsCheck is "run">>
					<<edenicon>><<link [[목적지에 도착한다.|Eden Fluids Punishment]]>><</link>>
				<<elseif !$edenHotSpring and Weather.isFreezing>>
					<<edenicon>><<link [[목적지에 도착한다.|Eden Hot Spring Creation 1]]>><</link>>
				<<else>>
					<<edenicon>><<link [[목적지에 도착한다.|Eden Clearing]]>><</link>>
				<</if>>
				<<case "wolf_cave_yard">>
				곧 길은 짐승이 다니는 오솔길 정도로 좁아지고, 귀에 익은 늑대 무리의 소리가 당신을 그들의 빈터로 이끈다.<br><br><<bikeGains>>
					<<wolfcaveicon>><<link [[목적지에 도착한다.|Wolf Cave Clearing]]>><</link>>
				<<case "moor">>
				곧 언덕 너머로 성이 빼꼼 모습을 드러낸다<<if $syndromebird gte 1>>. 멀리서 귀에 익은 울음소리가 집에 돌아온 당신을 맞이한다.<<else>>.<</if>><br><br><<bikeGains>>
					<<mooricon>><<link [[목적지에 도착한다.|Moor]]>><<set $moor to 100>><</link>>
			<</switch>>
				<br><br>
				<<endevent>>
		<<case true>>
			자전거를 타고 가던 중, <<print either("타이어에서 바람이 빠진다.", "체인이 위태롭게 덜컹거린다.", "핸들이 헐거워진다.", "페달이 툭 빠져 버린다.")>>
			<span class="red">목적지에 닿기도 전에 자전거가 망가졌다!</span>
			<br><br>
			계속 타려면 자전거 매장에서 수리받<<if $bicycle.durability.repair isnot undefined>>거나 직접 손보<</if>>아야 한다. <span class="yellow">그래도 운동은 조금 했다.</span>
			<<set _fatigue to (Math.trunc($bicycle.gains.fatigue*0.35))>><<set _athletics to (Math.trunc($bicycle.gains.athletics*0.35))>>
			<<tiredness _fatigue>><<athletics _athletics>>
			<<if $bicycle.roughTerrain gt 0>><<set _physique to (Math.trunc($bicycle.gains.physique*0.35))>><<silently>><<physique _physique>><</silently>><</if>>
			<<gtiredness>><<gathletics>>
			<<switch $bicycle.start>>
				<<case "residential" "commercial">>
					<<switch _destinationRegion>>
						<<case "residential" "commercial" "industrial">>
							<<set _interrupt to either($bicycle.destinations.Residential.random(), $bicycle.destinations.Commercial.random(), $bicycle.destinations.Industrial.random())>>
						<<case "forest" "forestEntrance" "lake">>
							<<set _interrupt to either($bicycle.destinations.Commercial.random(), $bicycle.destinations.Commercial.random())>>
						<<case "alex_farm" "moor">>
							<<set _interrupt to either($bicycle.destinations.Commercial.random(), $bicycle.destinations.Industrial.random(), "Farm Road 1", "Farm Road 2")>>
					<</switch>>
				<<case "industrial">>
					<<switch _destinationRegion>>
						<<case "residential" "commercial" "industrial">>
							<<set _interrupt to either($bicycle.destinations.Residential.random(), $bicycle.destinations.Commercial.random(), $bicycle.destinations.Industrial.random())>>
						<<case "forest" "forestEntrance" "lake">>
							<<set _interrupt to either($bicycle.destinations.Commercial.random(), $bicycle.destinations.Commercial.random())>>
						<<case "alex_farm" "moor">>
							<<set _interrupt to either($bicycle.destinations.Industrial.random(), "Farm Road 1", "Farm Road 2")>>
					<</switch>>
				<<case "forest" "forestEntrance" "lake">>
					<<switch _destinationRegion>>
						<<case "residential" "commercial" "industrial">>
							<<set _interrupt to either($bicycle.destinations.Commercial.random(), $bicycle.destinations.Commercial.random(), "Forest")>>
						<<case "forest" "forestEntrance">>
							<<set _interrupt to "Forest">>
						<<case "alex_farm" "moor">>
							<<set _interrupt to either($bicycle.destinations.Commercial.random(), $bicycle.destinations.Industrial.random(), "Farm Road 1", "Farm Road 2", "Farm Road 3")>>
					<</switch>>
				<<case "alex_farm">>
					<<switch _destinationRegion>>
						<<case "residential" "commercial" "industrial">>
							<<set _interrupt to either($bicycle.destinations.Commercial.random(), $bicycle.destinations.Industrial.random(), "Farm Road 1", "Farm Road 2")>>
						<<case "forest" "forestEntrance" "lake">>
							<<set _interrupt to either($bicycle.destinations.Commercial.random(), $bicycle.destinations.Industrial.random(), "Farm Road 1", "Farm Road 2")>>
						<<case "moor">>
							<<set _interrupt to "Moor">>
					<</switch>>
				<<case "moor">>
					<<switch _destinationRegion>>
						<<case "residential" "commercial">>
							<<set _interrupt to either("Moor", "Farm Road 6", "Farm Road 4", "Farm Road 2", $bicycle.destinations.Industrial.random())>>
						<<case  "industrial">>
							<<set _interrupt to either ("Moor", "Farm Road 6", "Farm Road 4", "Farm Road 2")>>
						<<case "forest" "forestEntrance"  "lake">>
							<<set _interrupt to either("Moor", "Farm Road 6", "Farm Road 4", "Farm Road 2", $bicycle.destinations.Industrial.random(), $bicycle.destinations.Commercial.random())>>
						<<case "alex_farm">>
							<<set _interrupt to "Moor">>
					<</switch>>
				<<default>>
					<<bikeError>>
				<</switch>>
			<br><br>
			<<walkicon>><<link [[걷기 시작한다|_interrupt]]>><<unset $phase>><<endevent>><<set $eventskip to 0>><<if _interrupt is "Forest">><<set $forest to random(0,10)>><<elseif _interrupt is "Moor">><<set $moor to random(5, 50)>><</if>><</link>>
		<</switch>>
<</widget>>

<<widget "bikeError">>
	<span class="red">문제가 생겼습니다.</span> 프로스트버그에게 알리고 저장 파일을 첨부해 주십시오.
	<br><br>
	<<print $bicycle.location>><br>
	<<print $destination>><br>
	<<print $rng>><br>
	<<print Time.season>><br>
	<<print Weather.precipitation>><br>
	<<print Weather.dayState>><br>
	<<domusquick>>
<</widget>>

<<widget "bikeMenu">>
	<<run bikeTime("residential")>>
	주택가:<br>
		<<if $bicycle.location is "domus">><<else>><<domusicon>><<link [["도무스 가 (" + _time.rTime + ") (집)"|Bike Ride]]>><<pass $bicycle.travel.rTime>><<set $bicycle.time to $bicycle.travel.rTime>><<set $destination to "domus">><</link>><br><</if>>
		<<if $bicycle.location is "barb">><<else>><<barbicon>><<link [["바브 가 (" + _time.rTime + ") (원룸)"|Bike Ride]]>><<pass $bicycle.travel.rTime>><<set $bicycle.time to $bicycle.travel.rTime>><<set $destination to "barb">><</link>><br><</if>>
		<<if $bicycle.location is "danube">><<else>><<danubeicon>><<link [["다뉴브 가 (" + _time.rTime + ") (저택)"|Bike Ride]]>><<pass $bicycle.travel.rTime>><<set $bicycle.time to $bicycle.travel.rTime>><<set $destination to "danube">><</link>><br><</if>>
		<<if $bicycle.location is "wolf">>
		<<elseif $bicycle.location is "lake" || $bicycle.location is "cabin" || $bicycle.location is "wolf_cave_yard">>
			<<run bikeTime("forestEntrance")>>
			<<wolficon>><<link [["울프 가 (" + _time.fETime + ") (신전)"|Bike Ride]]>><<pass $bicycle.travel.fETime>><<set $bicycle.time to $bicycle.travel.fETime>><<set $destination to "wolf">><</link>><br>
		<<else>>
		<<wolficon>><<link [["울프 가 (" + _time.rTime + ") (신전)"|Bike Ride]]>><<pass $bicycle.travel.rTime>><<set $bicycle.time to $bicycle.travel.rTime>><<set $destination to "wolf">><</link>><br>
		<</if>>
		<br>

	<<run bikeTime("commercial")>>
	상업 지구:<br>
		<<if $bicycle.location is "cliff">><<else>><<clifficon>><<link [["클리프 가 (" + _time.cTime + ") (카페)"|Bike Ride]]>><<pass $bicycle.travel.cTime>><<set $bicycle.time to $bicycle.travel.cTime>><<set $destination to "cliff">><</link>><br><</if>>
		<<if $bicycle.location is "high">><<else>><<highicon>><<link [["하이 가 (" + _time.cTime + ") (쇼핑센터)"|Bike Ride]]>><<pass $bicycle.travel.cTime>><<set $bicycle.time to $bicycle.travel.cTime>><<set $destination to "high">><</link>><br><</if>>
		<<if $bicycle.location is "connudatus">><<else>><<connudatusicon>><<link [["콘누다투스 가 (" + _time.cTime + ") (클럽)"|Bike Ride]]>><<pass $bicycle.travel.cTime>><<set $bicycle.time to $bicycle.travel.cTime>><<set $destination to "connudatus">><</link>><br><</if>>
		<<if $bicycle.location is "nightingale">>
		<<elseif $bicycle.location is "lake" || $bicycle.location is "cabin" || $bicycle.location is "wolf_cave_yard" || $bicycle.location is "forest">>
			<<run bikeTime("forestEntrance")>>
			<<nightingaleicon>><<link [["나이팅게일 가 (" + _time.fETime + ") (병원)"|Bike Ride]]>><<pass $bicycle.travel.fETime>><<set $bicycle.time to $bicycle.travel.fETime>><<set $destination to "nightingale">><</link>><br>
		<<else>>
			<<nightingaleicon>><<link [["나이팅게일 가 (" + _time.cTime + ") (병원)"|Bike Ride]]>><<pass $bicycle.travel.cTime>><<set $bicycle.time to $bicycle.travel.cTime>><<set $destination to "nightingale">><</link>><br>
		<</if>>
		<<run bikeTime("commercial")>>
		<<if $bicycle.location is "oxford">><<else>><<oxfordicon>><<link [["옥스포드 가 (" + _time.cTime + ") (학교)"|Bike Ride]]>><<pass $bicycle.travel.cTime>><<set $bicycle.time to $bicycle.travel.cTime>><<set $destination to "oxford">><</link>><br><</if>>
		<<if $bicycle.location is "starfish">><<else>><<starfishicon>><<link [["스타피쉬 가 (" + _time.cTime + ") (해변)"|Bike Ride]]>><<pass $bicycle.travel.cTime>><<set $bicycle.time to $bicycle.travel.cTime>><<set $destination to "starfish">><</link>><br><</if>>
		<br>

	<<run bikeTime("industrial")>>
	공업 지구:<br>
		<<if $bicycle.location is "elk">><<else>><<elkicon>><<link [["엘크 가 (" + _time.iTime + ")"|Bike Ride]]>><<pass $bicycle.travel.iTime>><<set $bicycle.time to $bicycle.travel.iTime>><<set $destination to "elk">><</link>><br><</if>>
		<<if $bicycle.location is "harvest">><<else>><<harvesticon>><<link [["하베스트 가 (" + _time.iTime + ") (술집)"|Bike Ride]]>><<pass $bicycle.travel.iTime>><<set $bicycle.time to $bicycle.travel.iTime>><<set $destination to "harvest">><</link>><br><</if>>
		<<if $bicycle.location is "mer">><<else>><<mericon>><<link [["메르 가 (" + _time.iTime + ") (부두)"|Bike Ride]]>><<pass $bicycle.travel.iTime>><<set $bicycle.time to $bicycle.travel.iTime>><<set $destination to "mer">><</link>><br><</if>>
		<br>

	숲:<br>
	<<run bikeTime("lake")>>
		<<if $bicycle.location is "lake">><<else>><<lakeicon>><<link [["호수 (" + _time.lTime + ")"|Bike Ride]]>><<pass $bicycle.travel.lTime>><<set $bicycle.time to $bicycle.travel.lTime>><<set $destination to "lake">><</link>><br><</if>>
	<<if ($edenfreedom gte 1 or $syndromeeden gte 1) || $syndromewolves gte 1 || $forest_shop_intro is 1>>
		<<run bikeTime("forestEntrance")>>
			<<if $bicycle.location is "forest">><<else>><<if $forest_shop_intro is 1>><<shopicon  "forest">><<link [["숲속 상점 (" + _time.fETime + ")"|Bike Ride]]>><<pass $bicycle.travel.fETime>><<set $bicycle.time to $bicycle.travel.fETime>><<set $destination to "forestEntrance">><</link>><br><</if>><</if>>
		<<run bikeTime("forest")>>
		<<if $edenfreedom gte 1 or $syndromeeden gte 1>>
			<<if $bicycle.location is "cabin">>
			<<else>>
				<<edenicon>><<link [["에덴의 오두막 (" + _time.fTime + ")"|Bike Ride]]>><<pass $bicycle.travel.fTime>><<set $bicycle.time to $bicycle.travel.fTime>><<set $destination to "cabin">><</link>><br>
			<</if>>
		<</if>>
		<<if $syndromewolves gte 1>>
			<<if $caveHumanPregnancyDiscovered isnot 1 or !playerIsPregnant()>>
				<<if $bicycle.location is "wolf_cave_yard">>
				<<else>>
					<<wolfcaveicon>><<link [["늑대 동굴 (" + _time.fTime + ")"|Bike Ride]]>><<pass $bicycle.travel.fTime>><<set $bicycle.time to $bicycle.travel.fTime>><<set $destination to "wolf_cave_yard">><</link>><br><</if>>
			<<else>><span class="blue">임신이 끝나기 전까지는 늑대들이 당신의 귀환을 허락하지 않을 것 같다.</span><br><</if>>
			<</if>>
			<br>
	<<else>>
	<</if>>

	<<if $bicycle.farmlandsUnlocked isnot true>>
	<<elseif $bicycle.location is "alex_farm">>
	<<else>>
	평원:<br>
	<<run bikeTime("alex_farm")>>
		<<farmicon>><<link [["농장 (" + _time.aTime + ")"|Bike Ride]]>><<pass $bicycle.travel.aTime>><<set $bicycle.time to $bicycle.travel.aTime>><<set $destination to "alex_farm">><</link>><br>
	<</if>>
	<br>
	<<if $bicycle.castleUnlocked isnot true>>
	<<elseif $bicycle.location is "moor">>
	<<else>>
	황야:<br>
	<<run bikeTime("moor")>>
		<<mooricon>><<link [["황야의 성 (" + _time.mTime + ")"|Bike Ride]]>><<pass $bicycle.travel.mTime>><<set $bicycle.time to $bicycle.travel.mTime>><<set $destination to "moor">><</link>><br>
	<</if>>
<</widget>>

<<widget "bikeEvents">>
	<<switch _args[0]>>
		<<case "lake" "forestEntrance" "forest">>
			<<switch Weather.dayState>>
				<<case "night">>
					<<if Weather.precipitation is "snow" || Weather.isSnow is true>>
						검은 눈이 소리 없이 내려 길 위를 얇게 덮는다. 고요한 숲속을 조심스레 나아가는 동안, 타이어 아래로 새로 내린 눈이 바삭하게 부서진다.
					<<elseif Weather.precipitation is "rain">>
						검은 비가 쏟아져 길이 미끄럽다. 구불구불한 숲길을 조심스레 달리는 동안, 자전거 타이어가 물보라를 튀겨 올린다.
					<<elseif Weather.isOvercast is false>>
						나무 위로 별빛이 희미하게 보인다. 고요한 숲속을 달리는 당신의 길을 비추기에 딱 알맞은 빛이다.
					<<else>>
						두꺼운 구름이 하늘을 덮어 밤이 더욱 어둡다. 자전거 전등이 앞길을 비추려 안간힘을 쓴다.
					<</if>>
				<<case "dusk">>
					<<if Weather.precipitation is "rain">>
						저녁 비가 매끈한 길 위에서 반짝이며 거울 같은 표면을 만든다. 당신은 숲길을 조심스레 달린다.
					<<elseif Weather.precipitation is "snow" || Weather.isSnow is true>>
						밤을 맞아 눈이 쌓이기 시작하고, 해질녘이 밤으로 저물며 타이어 아래에서 부드럽게 바삭거린다.
					<<elseif Weather.isOvercast is false>>
						지는 해가 길 위에 따스한 금빛을 드리우며, 하루가 저무는 가운데 당신의 길을 이끈다.
					<<else>>
						무거운 구름이 머리 위로 몰려들고, 빛이 스러지면서 숲길이 어두워진다.
					<</if>>
				<<case "dawn">>
					<<if Weather.precipitation is "rain">>
						이른 아침의 비가 길 위에서 반짝이고, 상쾌하고 서늘한 공기 속을 달리는 자전거가 작은 물보라를 튀겨 올린다.
					<<elseif Weather.precipitation is "snow" || Weather.isSnow is true>>
						눈이 이불처럼 쌓여 새벽빛을 반사하고, 평화로운 숲을 지나는 길이 선명한 하얀 길로 변한다.
					<<elseif Weather.isOvercast is false>>
						나무 사이로 해가 떠올라 길 위에 긴 그림자를 드리운다. 고요하게 시작되는 라이딩이다.
					<<else>>
						하늘에 구름이 두껍게 끼어 아침이 회색빛으로 서늘하다. 당신은 숲을 지나 페달을 밟아 나아간다.
					<</if>>
				<<default>>
					<<if Weather.precipitation is "rain">>
						비에 젖은 길이 타이어 아래에서 반짝인다. 앞길은 미끄럽지만, 빗속을 뚫고 나아갈 만하다.
					<<elseif Weather.precipitation is "snow" || Weather.isSnow is true>>
						길에 눈이 얇게 내려앉아, 겨울 풍경 속을 달리는 타이어 아래에서 부드럽게 바삭거린다.
					<<elseif Weather.isOvercast is false>>
						햇빛이 나무 사이로 약하게 비치고, 창백한 빛이 매끈한 길에 반사되는 가운데 당신은 여정을 이어 간다.
					<<else>>
						구름이 낮고 무겁게 걸려 낮을 어둑하게 하고, 숲 위로 차가운 빛을 드리운다.
					<</if>>
			<</switch>>
			<br>
			<<if dangerEvent()>><br>
				<<cleareventpool>>
					<<switch Time.season>>
						<<case "spring" "summer">>
							<<addinlineevent 2>>
							<<if Weather.precipitation is "none" && !Weather.isOvercast && Weather.dayState is "day">>
								숲속을 자전거로 달리는 동안 나무에서 새들이 지저귄다. 바로 앞에 커다란 파리 떼가 보여, 피하려고 왼쪽으로 살짝 방향을 튼다.<<stress -3>><<lstress>><<set _phase to 1>>
								<br>
							<<elseif Weather.precipitation is "rain">>
								하늘에서 비가 쏟아지는 가운데, 당신은 숲속을 달려 목적지로 향한다. 시야는 나쁘고 길은 미끄러운데, 급커브가 나타나는 순간 하마터면 미끄러질 뻔한다.
								<br><br>
								다행히 자전거를 제어해, 바로 옆 개울로 미끄러져 빠지는 일은 피한다.<<stress -3>><<lstress>><<set _phase to 1>>
								<br>
							<</if>>
							<</addinlineevent>>
							<<addinlineevent>>
							<<if Weather.precipitation is "none" && !Weather.isOvercast && Weather.dayState is "day">>
								숲속을 자전거로 달리던 중, 오른쪽에서 들리는 이상한 소리에 주의를 빼앗긴다. 소리의 근원을 찾다가 다시 길로 고개를 돌리는 순간, 무언가가 입과 코로 곧장 날아든다.
								<br><br>
								입에 날아든 것을 뱉어 내고 가려워진 코를 문지르며 뒤쪽 길을 돌아본다. 방금 지나온 길 위에서 파리 떼가 윙윙거리고 있다.<<stress 3>><<gstress>><<set _phase to 1>>
								<br>
							<<elseif Weather.precipitation is "rain">><<dancedifficulty 1 1000 true>>
								길은 옆을 흐르는 개울의 모양을 따라 뱀처럼 굽이굽이 이어진다. 비가 위쪽 나뭇잎 사이로 부드럽게 걸러져 내린다.
								<br><br>
								갑작스러운 폭우에 앞길이 잘 보이지 않아, 땅을 덮은 풀 사이로 튀어나온 작은 바위를 너무 늦게야 알아챈다. 앞바퀴가 튀어 오르며 손에 무시무시한 충격이 전해진다.
								<br><br>
								<<if $danceSuccess>>
									<span class="green">당신은 핸들을 놓치지 않고 균형을 유지한다.</span> 아드레날린이 순간 치솟았다가 곧바로 안도감이 밀려오며 온몸이 짜릿하다.<<lstress>><<stress -6>>
									<br>
								<<else>>
									<span class="red">핸들을 쥔 손이 미끄러지며 자전거가 기울어,</span> 당신은 곤두박질치며 물보라를 일으키고 개울에 빠진다.<<gpain>><<pain 6>><<wetAll>>
									<br><br>
									다행히 몸은 멀쩡하지만, 젖지 않은 곳은 없다.<<stress 6>><<gstress>><<set $bicycle.durability.current -= 100>>
									<br>
								<</if>>
							<<set _phase to 1>>
							<</if>>
							<</addinlineevent>>
							<<addinlineevent>><</addinlineevent>>
 							<<addinlineevent 2>>
								/* insert lake/forest danger event pool passages? spring/summer would lean towards prey animals/young adults */
							<</addinlineevent>>
						<<case "autumn">>
							<<addinlineevent>>
								<<if Weather.precipitation is "rain">><<dancedifficulty 1 1000 true>>
									길은 옆을 흐르는 개울의 모양을 따라 뱀처럼 굽이굽이 이어진다. 비가 위쪽 나뭇잎 사이로 부드럽게 걸러져 내린다.
									<br><br>
									갑작스러운 폭우에 앞길이 잘 보이지 않아, 땅을 덮은 풀 사이로 튀어나온 작은 바위를 너무 늦게야 알아챈다. 앞바퀴가 튀어 오르며 손에 무시무시한 충격이 전해진다.
									<br><br>
									<<if $danceSuccess>>
										<span class="green">당신은 핸들을 놓치지 않고 균형을 유지한다.</span> 아드레날린이 순간 치솟았다가 곧바로 안도감이 밀려오며 온몸이 짜릿하다.<<lstress>><<stress -6>>
										<br>
									<<else>>
										<span class="red">핸들을 쥔 손이 미끄러지며 자전거가 기울어,</span> 당신은 곤두박질치며 물보라를 일으키고 개울에 빠진다.<<gpain>><<pain 6>><<wetAll>>
										<br><br>
										다행히 몸은 멀쩡하지만, 젖지 않은 곳은 없다.<<stress 6>><<gstress>><<set $bicycle.durability.current -= 100>>
										<br>
									<</if>>
								<<set _phase to 1>>
								<</if>>
							<</addinlineevent>>
							<<addinlineevent>><</addinlineevent>>
							<<addinlineevent>><</addinlineevent>>
							<<addinlineevent>><</addinlineevent>>
							/* bear/boar events (higher activity prepping for winter) */
						<<case "winter">>
							<<addinlineevent>><</addinlineevent>>
							<<addinlineevent>><</addinlineevent>>
							<<addinlineevent>><</addinlineevent>>
						<<default>><<addinlineevent>><</addinlineevent>>
					<</switch>>
				<<runeventpool>>
			<</if>>
		<<case "domus" "barb" "danube" "connudatus" "wolf" "high" "cliff" "nightingale" "starfish" "oxford" "elk" "mer" "harvest">>
			<<switch Weather.dayState>>
				<<case "night">>
					<<if Weather.precipitation is "rain">>
						빗물이 거리를 따라 흘러내려 희미한 가로등 불빛을 비추고, 커브를 돌 때마다 타이어가 물보라를 튀겨 올린다.
					<<elseif Weather.precipitation is "snow" || Weather.isSnow is true>>
						눈이 마을을 뒤덮어, 조용한 가게와 집들을 지나는 당신의 타이어 아래로 길이 미끄럽다.
					<<elseif Weather.isOvercast is false>>
						하늘 위로 별빛이 희미하고, 잠든 마을을 달리는 동안 대부분의 빛은 가로등이 내어 준다.
					<<else>>
						두꺼운 구름이 하늘을 덮어 자연광이 모두 가로막히고, 앞길 위에서 자전거 전등이 깜박인다.
					<</if>>
				<<case "dusk">>
					<<if Weather.precipitation is "rain">>
						저녁 비가 마을 길을 반짝이는 길로 바꿔 놓지만, 당신은 조심스레 달려 젖은 거리에서도 중심을 잃지 않는다.
					<<elseif Weather.precipitation is "snow" || Weather.isSnow is true>>
						눈이 쌓이기 시작해, 평화롭고 눈 덮인 마을을 달리는 타이어 소리가 부드러워진다.
					<<elseif Weather.isOvercast is false>>
						해가 지붕 아래로 기울며 길 위에 긴 그림자를 드리운다. 당신은 마을을 가로질러 나아간다.
					<<else>>
						먹구름이 모여 흐린 하늘이 마지막 햇살을 가린 채, 당신은 마을 거리를 달린다.
					<</if>>
				<<case "dawn">>
					<<if Weather.precipitation is "snow">>
						눈이 아침 햇살을 반사해 거리를 하얀 이불로 뒤덮고, 타이어는 뒤에 자국을 남긴다.
					<<elseif Weather.precipitation is "rain">>
						새벽빛이 비에 젖은 거리에서 반짝이고, 고요한 마을을 달리는 타이어가 얕은 물웅덩이를 튀기며 지나간다.
					<<elseif Weather.isOvercast is false>>
						해가 지붕 위로 떠올라 마을을 밝히고, 당신은 고요한 거리를 페달을 밟아 지나간다.
					<<else>>
						두꺼운 구름이 하늘을 회색으로 물들여, 이른 아침을 달리는 거리에 서늘한 빛을 드리운다.
					<</if>>
				<<default>>
					<<if Weather.precipitation is "snow">>
						거리가 눈으로 덮여, 타이어가 서리 낀 땅을 제대로 붙잡지 못해 속도가 느려진다.
					<<elseif Weather.precipitation is "rain">>
						비가 쏟아져 마을 거리를 적시고, 시간이 흐를수록 옷이 점점 무거워진다.
					<<elseif Weather.isOvercast is false>>
						해가 약하게 비칠 뿐 온기는 거의 주지 않고, 당신은 쌀쌀한 마을을 달린다.
					<<else>>
						짙은 구름이 하늘을 덮어, 마을 거리를 달리는 당신 위로 칙칙한 회색빛을 드리운다.
					<</if>>
			<</switch>>
			<br>
			<<if dangerEvent()>><br>
				<<cleareventpool>>
					<<switch Time.season>>
						<<case "spring" "summer">>
							<<addinlineevent 2>>
							<<if Weather.precipitation is "none" && !Weather.isOvercast && Weather.dayState is "day">>
								자전거로 마을을 달리는 중에 작은 파리 떼가 길을 가로지른다. 다행히 제때 발견해 옆으로 피한다.<<stress -3>><<lstress>><<set _phase to 1>>
								<br>
							<<elseif Weather.precipitation is "rain">>
								하늘에서 비가 쏟아지는 가운데 당신은 목적지로 달린다. 물이 배수로를 따라 빠르게 흐르지만, 배수로는 그 많은 물을 감당하느라 애를 먹고 있다.
								<br><br>
								차 한 대가 빠른 속도로 지나가며 사방으로 물을 튀긴다. 다행히 가장 큰 물보라는 몇 인치 차이로 당신을 비껴간다.<<stress -3>><<lstress>><<set _phase to 1>>
								<br>
							<</if>>
							<</addinlineevent>>
							<<addinlineevent>>
							<<if Weather.precipitation is "none" && !Weather.isOvercast && Weather.dayState is "day">>
								마을을 달리는 즐거움에 빠져 있는데, 갑자기 작은 파리 떼가 길을 가로지른다. 너무 늦게 알아챈 탓에 파리 떼 속을 통과하며 몇 마리를 삼키고 만다.
								<br><br>
								파리 한 마리가 곧장 눈에 부딪힌다. 입에 들어간 것들을 뱉어 내고, 한 손으로 눈에 들어간 파리를 비벼 빼내려 한다. <<stress 3>><<gstress>><<pain 1>><<gpain>><<set _phase to 1>>
								<br>
							<<elseif Weather.precipitation is "rain">>
								자전거로 목적지를 향해 페달을 밟는데 머리 위 구름에서 비가 쏟아진다. 마을 배수구는 그 많은 비를 감당하느라 애를 먹고, 길이 물 아래로 사라지기 시작한다.
								<br><br>
								갑자기 차 한 대가 빠른 속도로 지나가며, 커다란 물보라가 옆구리를 덮쳐 당신을 머리끝부터 발끝까지 흠뻑 적신다.<<stress 3>><<gstress>><<wetAll>><<set _phase to 1>>
								<br>
							<</if>>
							<</addinlineevent>>
							<<addinlineevent>><</addinlineevent>>
							<<addinlineevent>><</addinlineevent>>
							<<addinlineevent>><</addinlineevent>>
						<<default>><<addinlineevent>><</addinlineevent>>
					<</switch>>
				<<runeventpool>>
			<</if>>
	<<case "alex_farm">>
		<<switch Weather.dayState>>
			<<case "night">>
				<<if Weather.precipitation is "rain">>
					비가 세차게 내려, 매끈한 길 위로 작은 물줄기가 흐르며 자전거 전등 불빛에 반짝인다.
				<<elseif Weather.precipitation is "snow" || Weather.isSnow is true>>
					눈이 농지 위로 흩날려 길을 두껍게 덮고, 타이어가 쌓여 가는 눈을 바삭 밟으며 나아간다.
				<<elseif Weather.isOvercast is false>>
					별들이 탁 트인 하늘 가득 펼쳐지고, 자전거는 고요한 시골을 매끄럽게 굴러간다.
				<<else>>
					두꺼운 구름이 밤하늘을 가려 더욱 어둡고, 자전거 전등이 시골길의 어둠을 가르려 안간힘을 쓴다.
				<</if>>
			<<case "dusk">>
				<<if Weather.precipitation is "rain">>
					해가 질 무렵 시골길 위에서 비가 반짝이고, 농지를 달리는 타이어가 작은 물보라를 튀겨 올린다.
				<<elseif Weather.precipitation is "snow" || Weather.isSnow is true>>
					눈이 들판과 길을 덮기 시작하고, 하늘에서 빛이 스러지는 가운데 자전거가 눈을 바삭바삭 밟고 나아간다.
				<<elseif Weather.isOvercast is false>>
					해가 농지 너머로 지며 들판 위에 긴 그림자를 드리운다. 당신은 고요한 풍경 속을 페달을 밟아 나아간다.
				<<else>>
					두꺼운 구름이 머리 위에 모여, 농지 위로 밤이 다가오며 하늘이 어두워진다.
				<</if>>
			<<case "dawn">>
				<<if Weather.precipitation is "rain">>
					해가 막 뜨기 시작하는 시골길 위에서 아침 비가 반짝이고, 타이어가 젖은 길을 튀기며 지나간다.
				<<elseif Weather.precipitation is "snow" || Weather.isSnow is true>>
					눈이 농지를 덮어 이른 아침 햇살을 반사하고, 타이어는 부드러운 눈 위에 깊은 자국을 남긴다.
				<<elseif Weather.isOvercast is false>>
					멀리 언덕 너머로 해가 떠올라 길과 들판을 밝히고, 당신은 평온한 농지를 달린다.
				<<else>>
					흐린 구름이 아침 하늘을 덮어, 농지를 달리는 당신 위로 시골 풍경에 회색빛을 드리운다.
				<</if>>
			<<default>>
				<<if Weather.precipitation is "rain">>
					비가 농지 위로 쏟아져 길이 미끄럽지만, 시골을 지나 앞으로 나아갈 만은 하다.
				<<elseif Weather.precipitation is "snow" || Weather.isSnow is true>>
					눈이 들판과 길을 뒤덮어, 깊이 쌓인 눈더미를 헤치고 나아가려 타이어가 애를 쓴다.
				<<elseif Weather.isOvercast is false>>
					해가 농지 위에 약하게 비치지만, 그 빛은 추위를 거의 덜어 주지 못한 채 당신은 탁 트인 풍경 속을 달린다.
				<<else>>
					흐린 구름이 하늘에 낮게 걸려, 여정을 이어 가는 당신 위의 농지에 칙칙한 빛을 드리운다.
				<</if>>
		<</switch>>
		<br>
		<<if dangerEvent()>><br>
			<<cleareventpool>>
				<<switch Time.season>>
					<<case "spring" "summer">>
						<<addinlineevent 2>>
						<<if Weather.precipitation is "none" && !Weather.isOvercast && Weather.dayState is "day">>
							탁 트인 풍경 속을 자전거로 달리는 동안 햇빛이 환하게 비친다. 커다란 파리 떼가 윙윙거리며 눈앞에 나타난다. 당신은 다가오는 파리 떼를 아슬아슬하게 피해 방향을 튼다.<<stress -3>><<lstress>><<set _phase to 1>>
							<br>
						<<elseif Weather.precipitation is "rain">>
							하늘은 흐리고 비가 빠른 속도로 땅에 쏟아진다. 벌써 배수구가 넘쳐 자전거 도로 옆에 깊은 물줄기가 생겼다.
							<br><br>
							미끄러운데도 당신은 달리는 내내 자전거 위에서 버텨 낸다.<<stress -3>><<lstress>><<set _phase to 1>>
							<br>
						<</if>>
						<</addinlineevent>>
						<<addinlineevent>>
						<<if Weather.precipitation is "none" && !Weather.isOvercast && Weather.dayState is "day">>
							탁 트인 풍경이 자전거를 탄 당신 곁으로 스쳐 간다. 갑자기 지나가던 차의 요란한 경적이 당신을 혼비백산하게 만든다. 차에 시선을 고정한 채 속으로 욕을 퍼붓느라, 바로 앞에 있는 검은 파리 덩어리를 알아채지 못한다.
							<br><br>
							알아챘을 때는 이미 너무 늦었다. 파리 떼가 머리를 에워싸고 입속으로 날아들기 시작한다. 파리 떼가 사라진 뒤 최대한 뱉어 내 보지만, 쓴맛이 오랫동안 입안에 남는다.<<stress 3>><<gstress>><<set _phase to 1>>
							<br>
						<<elseif Weather.precipitation is "rain">>
							자전거를 타고 가는데 머리 위 구름에서 폭우가 쏟아진다. 시야는 거의 없고 자전거 도로는 미끄럽다. 뒤에서 날카로운 마찰음이 울린다. 돌아보니 커다란 트럭이 도로에서 심하게 미끄러지고 있고, 바퀴 몇 개는 벌써 자전거 도로 위에 올라와 있다.
							<br><br>
							본능적으로 자전거를 오른쪽으로 꺾어, 키 큰 풀이 무성하고 비로 깊은 웅덩이가 가득한 들판에 처박힌다. 트럭 운전사는 다시 균형을 잡고 당신을 완전히 무시한 채 지나간다.<<stress 3>><<gstress>><<pain 1>><<gpain>><<wetAll>><<set $bicycle.durability.current -= 10>><<set _phase to 1>>
							<br>
						<</if>>
						<</addinlineevent>>
						<<addinlineevent>><</addinlineevent>>
						<<addinlineevent>><</addinlineevent>>
						<<addinlineevent>><</addinlineevent>>
					<<default>><<addinlineevent>><</addinlineevent>>
				<</switch>>
			<<runeventpool>>
		<</if>>				
	<<case "moor">>
		<<switch Weather.dayState>>
			<<case "night">>
				<<if Weather.precipitation is "snow" || Weather.isSnow is true>>
					눈이 황야의 윤곽을 흐려 숨은 구덩이와 늪지를 덮고 있다. 당신은 그림자 드리운 황야를 달리며 조심스레 눈을 밟고 나아가지만, 타이어가 미끄러진다.
				<<elseif Weather.precipitation is "rain">>
					황야는 어둡고 흠뻑 젖은 벌판이다. 비가 얼굴을 후려치고 타이어가 질척하고 울퉁불퉁한 땅에 살짝 빠져, 1미터를 나아가는 것도 고역이다.
				<<elseif Weather.isOvercast is false>>
					구름 틈새로 별이 희미하게 깜박이며 앞쪽 습지를 간신히 비춘다. 당신은 바퀴 아래 위험한 지반을 경계하며 천천히 움직인다.
				<<else>>
					어둠이 거의 절대적이다. 자전거 전등만을 길잡이 삼아, 흠뻑 젖은 이탄과 보이지 않는 움푹한 곳 위로 조심스레 나아간다.
				<</if>>
			<<case "dusk">>
				<<if Weather.precipitation is "snow" || Weather.isSnow is true>>
					울퉁불퉁한 땅 위로 새 눈이 내려, 단단한 땅과 숨은 늪을 구분하기가 더 어려워진다. 페달을 밟을 때마다 균형이 시험받는 가운데 당신은 조심스레 나아간다.
				<<elseif Weather.precipitation is "rain">>
					해질녘이 내려앉으며 비가 황야를 불길하게 번들거리게 한다. 타이어가 질척한 늪지를 철벅이며 지나는 동안, 울퉁불퉁한 곳과 웅덩이마다 속도가 느려진다.
				<<elseif Weather.isOvercast is false>>
					지는 해의 희미한 주황빛이 황야에 유령 같은 빛을 입힌다. 땅은 거칠지만 당신은 어떻게든 길을 골라 나아간다.
				<<else>>
					낮은 구름이 지평선을 어둡게 한다. 늪이 그림자 속에 앞으로 펼쳐져 있고, 타이어 아래의 길은 불확실하고 위험하다.
				<</if>>
			<<case "dawn">>
				<<if Weather.precipitation is "snow" || Weather.isSnow is true>>
					새벽빛이 눈 덮인 황야에 반사되어, 어떤 곳은 눈부시고 어떤 곳은 으스스하다. 부드럽고 울퉁불퉁한 땅 위에서는 페달 한 번 밟는 것도 위험이라, 당신은 천천히 달린다.
				<<elseif Weather.precipitation is "rain">>
					비가 황야를 적시고 아침 안개가 얼굴에 달라붙는다. 땅이 푹 꺼진 곳마다 바퀴를 노리는 함정이 되어, 당신은 질척한 땅을 힘겹게 뚫고 나아간다.
				<<elseif Weather.isOvercast is false>>
					떠오르는 해가 황야를 옅은 금빛으로 물들인다. 아름답지만 거친 지형 때문에 시선은 아래를 향한 채, 안전하게 지날 길을 살핀다.
				<<else>>
					회색 아침 구름이 머리 위에 드리워 있다. 황야는 고요하고, 습지 길을 나아가는 타이어의 바삭하고 철벅이는 소리만 들린다.
				<</if>>
			<<default>>
				<<if Weather.precipitation is "snow" || Weather.isSnow is true>>
					눈 이불이 황야의 가장 험한 지형을 가려 주지만, 자전거가 거친 땅을 덜컹거리며 지날 때마다 바퀴 자국과 요철이 고스란히 느껴진다.
				<<elseif Weather.precipitation is "rain">>
					황야의 울퉁불퉁한 표면 곳곳에 물이 고여, 젖은 땅을 억지로 건너는 타이어가 헛돌고 미끄러진다.
				<<elseif Weather.isOvercast is false>>
					해는 온기를 거의 주지 않지만 앞길을 가늠할 빛은 충분하다. 길은 길들여지지 않은 황야를 가로질러 구불구불 이어지며, 가차 없고 거칠다.
				<<else>>
					칙칙한 하늘이 아래의 차갑고 황량한 땅과 어울리게 머리 위에 걸려 있다. 황야가 방향을 틀 때마다 당신을 잡아당기는 가운데 당신은 앞으로 나아간다.
				<</if>>
		<</switch>>
		<br>
		<<if dangerEvent()>><br>
			<<cleareventpool>>
			<<switch Time.season>>
				<<case "spring" "summer">>
				<<addinlineevent 2>>
					<<if Weather.precipitation is "none" && !Weather.isOvercast && Weather.dayState is "day">>
						탁 트인 풍경 속을 자전거로 달리는 동안 햇빛이 환하게 비친다. 커다란 파리 떼가 윙윙거리며 눈앞에 나타난다. 당신은 다가오는 파리 떼를 아슬아슬하게 피해 방향을 튼다.<<stress -3>><<lstress>><<set _phase to 1>>
						<br>
					<<elseif Weather.precipitation is "rain">>
						하늘은 흐리고 비가 빠른 속도로 땅에 쏟아진다. 벌써 배수구가 넘쳐 자전거 도로 옆에 깊은 물줄기가 생겼다. 미끄러운데도 당신은 달리는 내내 자전거 위에서 버텨 낸다.<<stress -3>><<lstress>><<set _phase to 1>>
						<br>
					<</if>>
				<</addinlineevent>>
				<<addinlineevent>>
					<<if Weather.precipitation is "none" && !Weather.isOvercast && Weather.dayState is "day">>
						탁 트인 풍경이 자전거를 탄 당신 곁으로 스쳐 간다. 갑자기 지나가던 차의 요란한 경적이 당신을 혼비백산하게 만든다. 차에 시선을 고정한 채 속으로 욕을 퍼붓느라, 바로 앞에 있는 검은 파리 덩어리를 알아채지 못한다.
						<br><br>
						알아챘을 때는 이미 너무 늦었다. 파리 떼가 머리를 에워싸고 입속으로 날아들기 시작한다. 파리 떼가 사라진 뒤 최대한 뱉어 내 보지만, 쓴맛이 오랫동안 입안에 남는다.<<stress 3>><<gstress>><<set _phase to 1>>
						<br>
					<<elseif Weather.precipitation is "rain">>
						자전거를 타고 가는데 머리 위 구름에서 폭우가 쏟아진다. 시야는 거의 없고 자전거 도로는 미끄럽다. 뒤에서 날카로운 마찰음이 울린다. 돌아보니 커다란 트럭이 도로에서 심하게 미끄러지고 있고, 바퀴 몇 개는 벌써 자전거 도로 위에 올라와 있다.
						<br><br>
						본능적으로 자전거를 오른쪽으로 꺾어, 키 큰 풀이 무성하고 비로 깊은 웅덩이가 가득한 들판에 처박힌다. 트럭 운전사는 다시 균형을 잡고 당신을 완전히 무시한 채 지나간다.<<stress 3>><<gstress>><<pain 1>><<gpain>><<wetAll>><<set $bicycle.durability.current -= 10>><<set _phase to 1>>
						<br>
					<</if>>
				<</addinlineevent>>
				<<addinlineevent>><</addinlineevent>>
				<<addinlineevent>><</addinlineevent>>
				<<addinlineevent>><</addinlineevent>>
				<<default>><<addinlineevent>><</addinlineevent>>
			<</switch>>
			<<runeventpool>>
		<</if>>				

	<<case "cabin" "wolf_cave_yard">>
		<<switch Weather.dayState>>
			<<case "night">>
				<<if Weather.precipitation is "rain">>
					굵은 빗방울이 머리 위 숲 지붕을 두드리며 뚝뚝 떨어진다. 오솔길은 뿌리와 진흙투성이에 시야까지 나빠, 라이딩이 느리고 고된 밀고 나아가기로 변한다.
				<<elseif Weather.precipitation is "snow" || Weather.isSnow is true>>
					눈이 깊은 숲의 모든 소리를 삼킨다. 흰 이불 아래로 길은 거의 보이지 않고, 숨은 장애물에 타이어가 자주 미끄러진다.
				<<elseif Weather.isOvercast is false>>
					희미한 별빛이 나무 사이로 스며들어, 구불구불한 길을 간신히 보여 줄 뿐이다. 숲은 고요하고 어두운 가운데 당신은 조심스레 달린다.
				<<else>>
					나무들이 그림자의 검은 벽을 이룬다. 머리 위엔 구름이 끼고 달빛도 없어, 숨 막히는 어둠 속에서 자전거 전등이 유일한 길잡이다.
				<</if>>
			<<case "dusk">>
				<<if Weather.precipitation is "rain">>
					비 때문에 숲길이 위험하다. 땅은 미끄럽고 엉킨 뿌리투성이다. 시야가 빠르게 흐려져 당신은 기어가듯 속도를 늦춘다.
				<<elseif Weather.precipitation is "snow" || Weather.isSnow is true>>
					눈이 나무들 사이로 굵게 내려 숲을 덮고 지나가는 소리를 죽인다. 당신은 울퉁불퉁한 길 위에서 균형을 잡으려 애쓴다.
				<<elseif Weather.isOvercast is false>>
					해가 지며 나무 사이로 빛이 스며들지만 숲은 금세 어두워진다. 당신은 나무 둥치와 그림자 사이로 보이는 얼마 안 되는 것에 의지해 길을 찾는다.
				<<else>>
					흐릿해지는 빛이 두꺼운 구름 아래로 사라진다. 길은 둔덕과 뿌리가 뒤엉킨 미로인데, 다가오는 밤이 상황을 더 나쁘게 한다.
				<</if>>
			<<case "dawn">>
				<<if Weather.precipitation is "rain">>
					이슬비가 잎과 가지에 달라붙은 나무들 사이를 누빈다. 길은 젖어 질척하고, 온 신경을 집중해야 한다.
				<<elseif Weather.precipitation is "snow" || Weather.isSnow is true>>
					해가 캐노피 사이로 약하게 떠오르는 가운데 눈이 타이어 아래에서 바삭거린다. 그림자 속에 숨은 빙판을 경계하며 당신은 천천히 달린다.
				<<elseif Weather.isOvercast is false>>
					떠오르는 해가 나무 사이를 뚫고 들어와 길을 줄무늬로 비춘다. 아름답지만 지형은 여전히 느리고 울퉁불퉁하다.
				<<else>>
					회색 아침 구름이 숲을 어둑하게 만든다. 당신은 뿌리와 돌에 타이어가 덜컹거리는 가운데 조심스레 앞으로 나아간다.
				<</if>>
			<<default>>
				<<if Weather.precipitation is "rain">>
					깊은 숲속 길은 진흙탕 장애물 코스가 되어, 웅덩이와 뿌리 매듭이 모퉁이마다 타이어를 홱홱 잡아챈다.
				<<elseif Weather.precipitation is "snow" || Weather.isSnow is true>>
					땅이 눈으로 미끄러워, 타이어가 울퉁불퉁한 표면 위에서 미끄러지는 동안 당신은 중심을 잡으려 안간힘을 쓴다.
				<<elseif Weather.isOvercast is false>>
					잎 사이로 걸러진 햇살이 숲 곳곳에 얼룩처럼 내려앉는다. 평화롭지만, 지형 탓에 속도는 낮게 유지되고 손아귀는 긴장한 채다.
				<<else>>
					숲은 흐린 하늘 아래 어둑하고, 길은 여전히 예측할 수 없다. 1미터 1미터가 조심스러움으로 얻어진다.
				<</if>>
		<</switch>>
		<br>
		<<if dangerEvent()>><br>
			<<cleareventpool>>
				<<switch Time.season>>
					<<case "spring" "summer">>
					<<addinlineevent 2>>
						<<if Weather.precipitation is "none" && !Weather.isOvercast && Weather.dayState is "day">>
							숲속을 자전거로 달리는 동안 나무에서 새들이 지저귄다. 바로 앞에 커다란 파리 떼가 보여, 피하려고 왼쪽으로 살짝 방향을 튼다.<<stress -3>><<lstress>><<set _phase to 1>>
							<br>
						<<elseif Weather.precipitation is "rain">>
							하늘에서 비가 쏟아지는 가운데, 당신은 숲속을 달려 목적지로 향한다. 시야는 나쁘고 길은 미끄러운데, 급커브가 나타나는 순간 하마터면 미끄러질 뻔한다.
							<br><br>
							다행히 자전거를 제어해, 바로 옆 개울로 미끄러져 빠지는 일은 피한다.<<stress -3>><<lstress>><<set _phase to 1>>
							<br>
						<</if>>
					<</addinlineevent>>
					<<addinlineevent>>
						<<if Weather.precipitation is "none" && !Weather.isOvercast && Weather.dayState is "day">>
							숲속을 자전거로 달리던 중, 오른쪽에서 들리는 이상한 소리에 주의를 빼앗긴다. 소리의 근원을 찾다가 다시 길로 고개를 돌리는 순간, 무언가가 입과 코로 곧장 날아든다.
							<br><br>
							입에 날아든 것을 뱉어 내고 가려워진 코를 문지르며 뒤쪽 길을 돌아본다. 방금 지나온 길 위에서 파리 떼가 윙윙거리고 있다.<<stress 3>><<gstress>><<set _phase to 1>>
							<br>
						<<elseif Weather.precipitation is "rain">>
							숲속을 자전거로 달리는데 머리 위 구름에서 비가 쏟아진다. 비 때문에 앞이 잘 보이지 않는 데다, 길 위의 작은 바위에 중심을 잃고 자전거에서 떨어져 옆의 개울에 빠진다.
							<br><br>
							다행히 몸은 멀쩡하지만, 젖지 않은 곳은 없다. <<stress 3>><<gstress>><<wetAll>><<set $bicycle.durability.current -= 10>><<set _phase to 1>>
							<br>
						<</if>>
					<</addinlineevent>>
					<<addinlineevent>><</addinlineevent>>
					<<addinlineevent>><</addinlineevent>>
					<<addinlineevent>><</addinlineevent>>
					<<default>>
						<<addinlineevent>><</addinlineevent>>
				<</switch>>
			<<runeventpool>>
		<</if>>				
	<<default>>
		<<bikeError>>
	<</switch>>
<</widget>>

<<widget "bikeTransition">>
	<<switch $destination>>
		<<case "lake">>
			당신은 호수로 향하는 길을 따라간다.
		<<case "forestEntrance">>
			당신은 숲 외곽으로 향한다.
		<<case "domus" "barb" "danube" "wolf" "connudatus">>
			당신은 이정표를 따라 주택가로 향한다.
		<<case "high" "cliff" "nightingale" "starfish" "oxford">>
			당신은 이정표를 따라 상업 지구로 향한다.
		<<case "elk" "mer" "harvest">>
			당신은 이정표를 따라 공업 지구로 향한다.
		<<case "alex_farm">>
			당신은 평원에 들어서며 <<if $bicycle.location isnot "moor">>마을을 뒤로한다.<<else>>황야를 뒤로한다.<</if>>
		<<case "moor">>
			당신은 마을과 평원을 뒤로하고 황야에 들어선다.
		<<case "cabin" "wolf_cave_yard">>
			당신은 오솔길을 따라 숲의 더 깊은 곳으로 들어간다.
	<</switch>>
<</widget>>

<<widget "bikeGains">>
	<<if currentSkillValue('athletics') gte 800>>
		<<if $bicycle.time gt 5>>
		운동 실력 덕분에 이동이 꽤 수월하다.
		<</if>>
		<<set _f to Math.trunc($bicycle.gains.fatigue*0.85)>>
		<<tiredness _f>><<athletics $bicycle.gains.athletics>>
		<<physique 1>><<gtiredness>><<gathletics>><<if $bicycle.roughTerrain isnot 0>><<silently>><<physique $bicycle.gains.physique>><</silently>><<gphysique>><</if>><br><br>
	<<elseif currentSkillValue('athletics') gte 550>>
		<<if $bicycle.time gt 5>>
		탄탄한 체격 덕분에 이동이 그리 힘들지 않다.
		<</if>>
		<<set _f to Math.trunc($bicycle.gains.fatigue*0.95)>>
		<<tiredness _f>><<athletics $bicycle.gains.athletics>>
		<<physique 1>><<ggtiredness>><<gathletics>><<if $bicycle.roughTerrain isnot 0>><<silently>><<physique $bicycle.gains.physique>><</silently>><<gphysique>><</if>><br><br>
	<<elseif currentSkillValue('athletics') gte 325>>
		<<if $bicycle.time gt 5>>
		근육이 부족해서 이동이 생각했던 것보다 훨씬 힘들다.
		<</if>>
		<<tiredness $bicycle.gains.fatigue>><<athletics $bicycle.gains.athletics>>
		<<physique 1>><<ggtiredness>><<gathletics>><<if $bicycle.roughTerrain isnot 0>><<silently>><<physique $bicycle.gains.physique>><</silently>><<gphysique>><</if>><br><br>
	<<else>>
		<<if $bicycle.time gt 5>>
		라이딩 내내 적당한 속도를 유지하느라 애쓰며, 몇 번이나 넘어질 뻔한다.
		<</if>>
		<<set _f to Math.trunc($bicycle.gains.fatigue*1.25)>><<set _a to Math.trunc($bicycle.gains.athletics*0.85)>><<set _p to Math.trunc($bicycle.gains.physique*0.85)>>
		<<tiredness _f>><<athletics _a>>
		<<physique 1>><<gggtiredness>><<gathletics>><<if $bicycle.roughTerrain isnot 0>><<silently>><<physique _p>><</silently>><<gphysique>><</if>><br><br>
	<</if>>
<</widget>>