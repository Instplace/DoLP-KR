:: Widgets Mansion Bedroom Masturbate [widget]
<<widget "averyMasturbateOption">>
	<<if $awareness gte 0>>
		<<icon "avery_bedroom.png">><<link [[침대에서 자위한다|Mansion Bedroom Masturbate]]>><<set $masturbationstart to 1>><</link>>
		<br>
	<</if>>
<</widget>>

:: Mansion Bedroom Masturbate
<<set $location to "avery_mansion">>
<<set $bus to "avery_bedroom">>
<<set $avery_passage to $passage>>
<<set $outside to 0>>
<<effects>><<getTarget true>>
<<set _enableSexToys to true>>

<<if $avery_mansion is undefined or $avery_mansion is 0>>
	<<avery_mansion_init>>
<</if>>
<<if $avery_mansion.masturbate is undefined>>
	<<set $avery_mansion.masturbate to {}>>
<</if>>

/* Avery home check (schedule) */
<<set _sched to ($avery_mansion.schedule || "away")>>
<<set _awayStates to ["away","work","date","return"]>>
<<set _averyHome to (!_awayStates.includes(_sched))>>

<<if $masturbationstart is 1>>
	<<set $masturbationstart to 0>>
	<<if $masturbationstat is undefined or isNaN($masturbationstat)>>
		<<set $masturbationstat to 0>>
	<</if>>
	<<set $masturbationstat += 1>>
	<<masturbationstart>>

	당신은 푹신한 매트리스에 몸을 묻는다. 벨벳 같은 부드러움이 당신을 통째로 삼키고, 모든 굴곡은 감싸 안고 어르도록 만들어져 있다. 두 손으로 온몸을 더듬자 어질어질한 기분이 든다.
	<br><br>

	/* Start a simple timer only if Avery is home */
	<<if _averyHome>>
		<<set $timerMax to (_sched is "sleep" ? 60 : 40)>>
		<<set $timer to $timerMax>>
		<<set $avery_mansion.masturbate.active to true>>
		<<set $avery_mansion.masturbate.timer to $timer>>
		<<set $avery_mansion.masturbate.timerMax to $timerMax>>
	<<else>>
		<<set $avery_mansion.masturbate.active to false>>
		<<set $avery_mansion.masturbate.timer to 0>>
		<<unset $avery_mansion.masturbate.timerMax>>
		<<unset $timer>>
		<<unset $timerMax>>
	<</if>>
<</if>>

/* If Avery is home and the caution meter is full, resolve the caught event inline. */
<<if _averyHome and $timer isnot undefined and $timer lte 0>>
	<<include "Mansion Bedroom Masturbate Caught">>
<<else>>
	/* Text + Caution UI */
	<<if !_averyHome>>
		침실에는 당신뿐이다.
		<br><br>
	<<else>>
		<<set _max to ($timerMax || 40)>>
		<<set _t to ($timer || _max)>>
		<<set _caution to Math.round(100 - ((_t / _max) * 100))>>
		<<set _caution to Math.min(100, Math.max(0, _caution))>>
		에이버리가 저택 어딘가에 있으니, 당신은 조용히 있으려 애쓴다.
		<br><br>
		주의: <<print _caution>>%
		<div class="meter">
			<<print '<div class="redbar" style="width:' + _caution + '%"></div>'>>
		</div>
		<br><br>
	<</if>>

	<<masturbationeffects>>
	<<masturbationactions>>

	<<if _averyHome>>
		<<set $avery_mansion.masturbate.timer to ($timer is undefined ? 0 : $timer)>>
		<<set $avery_mansion.masturbate.timerMax to ($timerMax is undefined ? 0 : $timerMax)>>
		<<masturbationControls "timer">>
	<<else>>
		<<masturbationControls>>
	<</if>>
<</if>>

:: Mansion Bedroom Masturbate Finish
<<set $location to "avery_mansion">><<set $bus to "avery_bedroom">><<set $avery_passage to $passage>><<set $outside to 0>>
<<effects>>
<<avery_mansion>>
<<if $avery_mansion is undefined or $avery_mansion is 0>>
	<<avery_mansion_init>>
<</if>>
<<if $avery_mansion.masturbate is undefined>>
	<<set $avery_mansion.masturbate to {}>>
<</if>>
<<set _awayStates to ["away","work","date","return"]>>
<<set _homeNow to (!_awayStates.includes($avery_mansion.schedule || "away"))>>
<<set _t to ($timer is undefined or isNaN($timer) ? ($avery_mansion.masturbate.timer || 0) : $timer)>>

/* Resolve the caught event inline. */
<<if !$finish and _homeNow and _t lte 0>>
	<<include "Mansion Bedroom Masturbate Caught">>
<<else>>
	<<endmasturbation>>
	<<endcombat>>
	<<clotheson>>

	/* If player hit Stop, just exit */
	<<if $finish is 1>>
		당신은 멈추고 억지로 숨을 가다듬는다.
		<br><br>
		<<unset $finish>>
		<<set $avery_mansion.masturbate.active to false>>
		<<set $avery_mansion.masturbate.timer to 0>>
		<<unset $avery_mansion.masturbate.finish>>
		<<unset $timer>>
		<<unset $timerMax>>
		<<link [[침대로 돌아간다|Mansion Bedroom]]>><</link>>
		<br>

	/* Otherwise, normal wrap-up */
	<<else>>
		당신은 몸을 닦고 아무 일 없었던 척하려 애쓴다.
		<br><br>
		<<set $avery_mansion.masturbate.active to false>>
		<<set $avery_mansion.masturbate.timer to 0>>
		<<unset $avery_mansion.masturbate.finish>>
		<<unset $timer>>
		<<unset $timerMax>>
		<<link [[침대로 돌아간다|Mansion Bedroom]]>><</link>>
		<br>
	<</if>>
<</if>>

:: Mansion Bedroom Masturbate Caught
<<set $location to "avery_mansion">><<set $bus to "avery_bedroom">><<set $avery_passage to $passage>><<set $outside to 0>>
<<effects>>
<<endmasturbation>>
<<endcombat>>
<<clothesontowel>>
<<avery_mansion>>
<<if $avery_mansion is undefined or $avery_mansion is 0>>
	<<avery_mansion_init>>
<</if>>

/* Clean session state so it can't linger */
<<if $avery_mansion and $avery_mansion.masturbate>>
	<<set $avery_mansion.masturbate.active to false>>
	<<set $avery_mansion.masturbate.timer to 0>>
	<<unset $avery_mansion.masturbate.finish>>
	<<unset $avery_mansion.masturbate.timerMax>>
<</if>>
<<unset $finish>>
<<unset $timer>>
<<unset $timerMax>>
<<npc Avery>><<person1>>
<<set _rage to (C.npc.Avery.rage is undefined ? 0 : C.npc.Avery.rage)>>

/* If dungeon unlocked, ALWAYS go dungeon */
<<if $avery_mansion.jobs and $avery_mansion.jobs.includes("dungeon")>>
	문간에 그림자가 드리운다.
	<br><br>
	<<if _rage gte 50>>
		"역겹군." 에이버리가 쏘아붙인다. "내 침대에서? 넌 정말 더러워."
		<br><br>
	<<else>>
		에이버리의 시선이 느릿하고 소유욕 어린 채로 머문다. "내 침대에서... 참을 수가 없었나?"
		<br><br>
	<</if>>
	"일어나." 에이버리가 말한다. "당장."
	<br><br>
	<<npcincr Avery dom 5>>
	<span class="red">집에 사자가 있을 때는 장난치면 안 된다는 걸 이제쯤 알았어야지</span>. |<span class="purple">+지배력</span>
	<br><br>
	<<link [[다음|Mansion Dungeon Intro 2]]>>
		<<set $bus to "avery_dungeon">>
		<<set $phase to 1>>
	<</link>>
	<br>
<<else>>
	문간에 그림자가 드리운다.
	<br><br>
	에이버리의 시선이 당신의 손과 당신이 벌여 놓은 난장판으로 내려갔다가, 다시 당신의 얼굴로 올라온다.
	<br><br>
	<<if _rage gte 50>>
		"한심하군." 에이버리가 내뱉는다. "내 침대에서 짐승처럼 제 몸을 만지다니. 감히 <i>내</i> 시트에 네 더러운 걸 묻히기까지 하고."
		<br><br>
		<<He>>【은는】 가까이 다가선다. "내 집에서 더럽게 굴 거라면, <span class="red">네가 누구 것인지 똑똑히 기억하게 해 주지</span>."
		<br><br>
		<<link [[다음|Mansion Bedroom Masturbate Fight]]>>
			<<set $averyCaughtTone to "rage">>
			<<set $fightstart to 1>>
		<</link>>
		<br>
	<<else>>
		에이버리의 입가가 만족스러운 미소로 휘어진다. "내 침대에서요? 내 자존심을 쓰다듬는 대담한 방법이네요."
		<br><br>
		<<He>>【은는】 몸을 기울인다. "여기서 달아오를 거라면... 제대로 해야죠. 나랑 같이."
		<br><br>
		<<link [[다음|Mansion Bedroom Masturbate Sex]]>>
			<<set $averyCaughtTone to "help">>
			<<set $sexstart to 1>>
		<</link>>
		<br>
	<</if>>
<</if>>

:: Mansion Bedroom Masturbate Sex
