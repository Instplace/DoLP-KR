:: Poppy Widgets [widget]
/*
│    ██████╗ ██████╗ ██████╗ ███████╗
│   ██╔════╝██╔═══██╗██╔══██╗██╔════╝
│   ██║     ██║   ██║██████╔╝█████╗
│   ██║     ██║   ██║██╔══██╗██╔══╝
│   ╚██████╗╚██████╔╝██║  ██║███████╗
│    ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚══════╝
*/
<<widget "poppySocialPrep">>
	<<script>>
		/* Only run if Poppy exists + met */
		if (C && C.npc && C.npc.Poppy && C.npc.Poppy.init === 1) {
			/* refresh derived status */
			try { if (typeof statusCheck === "function") statusCheck("Poppy"); } catch (e) {}

			/* signed source of truth: -100..100 */
			var raw = 0;
			if (typeof T !== "undefined" && T && typeof T.poppyPatienceRaw !== "undefined" && T.poppyPatienceRaw !== null) {
				raw = Number(T.poppyPatienceRaw) || 0;
			} else if (typeof C.npc.Poppy.patience !== "undefined" && C.npc.Poppy.patience !== null) {
				/* patience is always signed now; anger is a display-only mirror. */
				raw = Number(C.npc.Poppy.patience) || 0;
			}
			if (raw > 100) raw = 100; if (raw < -100) raw = -100;
			T.poppyPatienceRaw = raw;

			/* Keep patience signed; anger is a display-only mirror. */
			C.npc.Poppy.patience = raw; C.npc.Poppy.anger = Math.max(0, -raw);
			T.poppyPatience = Math.max(0, raw); T.poppyAnger = Math.max(0, -raw);

			/* mirror into V.NPCName record (relation-box uses npcData) */
			try {
				var pIdx = (V && V.NPCNameList) ? V.NPCNameList.indexOf("Poppy") : -1;
				if (pIdx >= 0 && V && V.NPCName && V.NPCName[pIdx]) {
					V.NPCName[pIdx].patience = C.npc.Poppy.patience;
					V.NPCName[pIdx].anger = C.npc.Poppy.anger;
				}
			} catch (e2) {}
		} else {
			T.poppyPatienceRaw = 0;
		}

		/* define once */
		if (!setup.poppyPatienceIcon) {
			setup.poppyPatienceIcon = function (val) {
				var v = Number(val) || 0;
				if (v < 0) v = 0;
				if (v > 100) v = 100;
				if (v <= 0) return "img/ui/sym-patience-empty.png";
				var step = Math.ceil(v / 20) * 20;
				return "img/ui/sym-patience-" + step + ".png";
			};
		}
	<</script>>
<</widget>>

/* For cheat menu */
<<widget "poppyTemper">>
	<<if ((typeof T !== "undefined" && T && typeof T.poppyPatienceRaw !== "undefined" && T.poppyPatienceRaw !== null) ? (Number(T.poppyPatienceRaw) || 0) : (Number(C.npc?.Poppy?.patience) || 0)) gte 0>>
		<<numberStepper "<img src='img/ui/sym-patience-100.png' class='icon'> 인내심" `C.npc.Poppy.patience` {
			callback: value => {
				let v = Math.max(-100, Math.min(100, Number(value) || 0));
				C.npc.Poppy.patience = v;
				C.npc.Poppy.anger = Math.max(0, -v);
				if (typeof statusCheck === "function") {
					statusCheck("Poppy");
				} else {
					T.poppyPatienceRaw = v;
					T.poppyPatience = Math.max(0, v);
					T.poppyAnger = Math.max(0, -v);
				}
				Wikifier.wikifyEval("<<replace '#poppytemper'>><<poppyTemper>><</replace>>");
				Wikifier.wikifyEval("<<replace '#poppydesc'>><<poppyTemperDesc>><</replace>>");
			},
			min: -100,
			max: 100,
			step: 1,
			percentage: false,
			valueFormat: value => `<b>${Math.abs(Number(value) || 0)}%</b>`
		}>>
	<<else>>
		<<numberStepper "<img src='img/ui/sym-poppy-rage.png' class='icon'> 분노" `C.npc.Poppy.patience` {
			callback: value => {
				let v = Math.max(-100, Math.min(100, Number(value) || 0));
				C.npc.Poppy.patience = v;
				C.npc.Poppy.anger = Math.max(0, -v);
				if (typeof statusCheck === "function") {
					statusCheck("Poppy");
				} else {
					T.poppyPatienceRaw = v;
					T.poppyPatience = Math.max(0, v);
					T.poppyAnger = Math.max(0, -v);
				}
				Wikifier.wikifyEval("<<replace '#poppytemper'>><<poppyTemper>><</replace>>");
				Wikifier.wikifyEval("<<replace '#poppydesc'>><<poppyTemperDesc>><</replace>>");
			},
			min: -100,
			max: 100,
			step: 1,
			percentage: false,
			valueFormat: value => `<b>${Math.abs(Number(value) || 0)}%</b>`
		}>>
	<</if>>
<</widget>>
<<widget "poppyTemperDesc">>
	<<if (Number(C.npc?.Poppy?.patience) || 0) gte 0>>
		포피의 인내심을 0% 아래로 내리면 분노로 바뀝니다.
	<<else>>
		0%로 다시 올리면 인내심으로 돌아옵니다.
	<</if>>
<</widget>>

/* BODYWRITING REACTION MID ENCOUNTER */
<<widget "bodypart_admire_poppy">>
	<<set _poppyOtherLI to ["Robin", "Whitney", "Kylar", "Sydney", "Eden", "Avery", "Alex", "Gwylan", "Black Wolf", "Great Hawk"]>>
	<<if _poppyOtherLI.includes($skin[_args[0]].special)>>
		<<run if (typeof statusCheck === "function") statusCheck("Poppy")>>
		<<if !$speechadmired>><<set $speechadmired to 1>>
			포피가 눈을 가늘게 뜬다. "<<print window.KR.getBodywritingKr($skin[_args[0]].writing)>>라니... 그럼 너, <<nnpc_him $skin[_args[0]].special>>의 것이기도 하다는 뜻이야?" <<He>>【은는】 당신의 <<bodypart _args[0]>> 위에 손바닥을 얹고, 피부가 찢어지지 않을 만큼만 날카로운 손톱을 파고들게 한다.
			<<npcincr Poppy love -2>><<llove>><<npcincr Poppy patience -4>><<llpatience>><<stress 300>><<gstress>><<pain 300>><<gpain>>
		<</if>>
	<<elseif $skin[_args[0]].pen is "tattoo">>
		<<run if (typeof statusCheck === "function") statusCheck("Poppy")>>
		<<if !$speechadmired>><<set $speechadmired to 1>>
			"잘 어울려." <<He>>【은는】 당신의 <<bodypart _args[0]>>【을를】 어루만진다. "그래서 네가 더 매력적으로 보여..." <<He>>【은는】 입술을 핥는다. <<if Number($poppyromance) gte 0>><<npcincr Poppy lust 3>><<glust>><br><</if>>
		<</if>>
	<<else>>
		<<bodypart_admire_generic _args[0]>>
	<</if>>
<</widget>>

/* POPPY ICONS */
<<widget "poppyicon">><<silently>>
	<<set _key to (_args[0] || "flat").toLowerCase()>>
	<<set _iconFile to "poppy/poppy-flat.png">>
	<<set _windowTime to (Weather.bloodMoon or $forcedBloodmoon) ? "bloodmoon" : (Weather.dayState is "night" ? "night" : "day")>>
	<<set _windowWeather to "clear">>

	<<switch Weather.name>>
		<<case "storm" "thunderstorm">>
			<<set _windowWeather to "stormy">>
		<<case "lightPrecipitation" "heavyPrecipitation">>
			<<if Weather.precipitation is "snow">>
				<<set _windowWeather to "cloudy">>
			<<else>>
				<<set _windowWeather to "rainy">>
			<</if>>
		<<case "cloudy">>
			<<set _windowWeather to "cloudy">>
		<<default>>
			<<if Weather.precipitation is "rain">>
				<<set _windowWeather to "rainy">>
			<<elseif Weather.precipitation is "snow">>
				<<set _windowWeather to "cloudy">>
			<</if>>
	<</switch>>

	<<switch _key>>
		<<case "living_room">>
			<<if $christmas is 1>>
				<<set _iconFile to "poppy/poppy-living-room-xmas.png">>
			<<else>>
				<<set _iconFile to "poppy/poppy-living-room.png">>
			<</if>>
		<<case "kitchen">>
			<<if $christmas is 1>>
				<<set _iconFile to "poppy/poppy-kitchen-xmas.png">>
			<<else>>
				<<set _iconFile to "poppy/poppy-kitchen.png">>
			<</if>>
		<<case "bathroom">>
			<<set _iconFile to "poppy/poppy-bath-room.png">>
		<<case "wardrobe">>
			<<set _iconFile to "poppy/poppy-wardrobe.png">>
		<<case "mirror">>
			<<set _iconFile to "poppy/poppy-mirror.png">>
		<<case "bed">>
			<<if $christmas is 1>>
				<<set _iconFile to "poppy/poppy-bed-xmas.png">>
			<<elseif $halloween is 1>>
				<<set _iconFile to "poppy/poppy-bed-halloween.png">>
			<<else>>
				<<set _iconFile to "poppy/poppy-bed.png">>
			<</if>>
		<<case "door">>
			<<if $christmas is 1>>
				<<set _iconFile to "poppy/poppy-door-xmas.png">>
			<<else>>
				<<set _iconFile to "poppy/poppy-flat.png">>
			<</if>>
		<<case "poppy">>
			<<set _iconFile to "poppy/poppy-poppy.png">>
		<<case "board">>
			<<set _iconFile to "poppy/poppy-wall-grid-board.png">>
		<<case "window">>
			<<set _iconFile to "poppy/poppy-window-" + _windowTime + "-" + _windowWeather + ".png">>
		<<case "flat">>
			<<if $halloween is 1>>
				<<set _iconFile to "poppy/poppy-flat-halloween.png">>
			<<else>>
				<<set _iconFile to "poppy/poppy-flat.png">>
			<</if>>
		<<default>>
			<<if $halloween is 1>>
				<<set _iconFile to "poppy/poppy-flat-halloween.png">>
			<<else>>
				<<set _iconFile to "poppy/poppy-flat.png">>
			<</if>>
	<</switch>>
<</silently>><<icon _iconFile>><</widget>>

/* Poppy pregnancy data migration */
<<widget "poppyPregnancy">>
	<<if $objectVersion.poppyPregnancy is undefined or $objectVersion.poppyPregnancy lt 2>>
		<<if C.npc.Poppy>>
			<<if C.npc.Poppy.pregnancy is undefined>>
				<<set C.npc.Poppy.pregnancy to { fetus: [], enabled: true, type: null }>>
			<<else>>
				<<if !Array.isArray(C.npc.Poppy.pregnancy.fetus)>>
					<<set C.npc.Poppy.pregnancy.fetus to []>>
				<</if>>
				<<if typeof C.npc.Poppy.pregnancy.enabled !== "boolean">>
					<<set C.npc.Poppy.pregnancy.enabled to true>>
				<</if>>
				<<if C.npc.Poppy.pregnancy.type is "none" or C.npc.Poppy.pregnancy.type is undefined>>
					<<set C.npc.Poppy.pregnancy.type to null>>
				<<elseif C.npc.Poppy.pregnancy.type and !C.npc.Poppy.pregnancy.fetus.length and !C.npc.Poppy.pregnancy.timerEnd>>
					<<set C.npc.Poppy.pregnancy.type to null>>
				<</if>>
			<</if>>
			<<set $objectVersion.poppyPregnancy to 2>>
		<</if>>
	<</if>>
<</widget>>

/*
│   ████████╗██████╗  █████╗ ██╗████████╗
│   ╚══██╔══╝██╔══██╗██╔══██╗██║╚══██╔══╝
│      ██║   ██████╔╝███████║██║   ██║
│      ██║   ██╔══██╗██╔══██║██║   ██║
│      ██║   ██║  ██║██║  ██║██║   ██║
│      ╚═╝   ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝   ╚═╝
*/

/*
	Caller:
	- <<poppyOpiumPulse>>             = repeated / auto-detect knowledge
	- <<poppyOpiumPulse 1>>           = repeated / force known-science version
	- <<poppyOpiumPulse false true>>   = first-time / auto-detect knowledge
	- <<poppyOpiumPulse 1 true>>      = first-time / force known-science version
*/
<<widget "poppyOpiumPulse">>
	<<set _poppyOpiumForceKnown to (_args.length gt 0 ? _args[0] : null)>>
	<<set _poppyOpiumFirstTime to (_args.length gt 1 ? !!_args[1] : false)>>
	<<set _poppyHasPavlovTrait to ($backgroundTraits.includes("pavlovpoppy"))>>
	<<set _poppyOpiumTiredGain to (_poppyHasPavlovTrait ? 2 : 3)>>

	<<run window.ensurePoppyTraitData ? window.ensurePoppyTraitData() : null>>
	<<run _poppyOpiumResult = poppyOpiumPulse(_poppyOpiumForceKnown)>>
	<br><br>
	<<if _poppyOpiumResult.relieved>>
		<<if _poppyOpiumFirstTime>>
			<span class="green"><i>가루 같은 향이 느껴지며 몸이 편안해진다.</i></span>
		<<else>>
			<span class="green"><i>몸이 편안해진다.</i></span>
		<</if>>
		<<lpain>><<pain -3>>
	<<else>>
		<<if _poppyOpiumFirstTime>>
			<span class="lewd"><i>가루 같은 향이 느껴지며 졸음이 몰려온다.</i></span>
		<<else>>
			<span class="lewd"><i>졸음이 몰려온다.</i></span>
		<</if>>
		<<gtiredness>><<tiredness _poppyOpiumTiredGain>>
	<</if>>

	<<if _poppyOpiumResult.learnedKnowledge>>
		<br>
		<span class="red"><i>그동안 아편을 들이마시고 있었고, 그 때문에 졸음이 온다는 것을 깨닫는다.</i></span>
	<</if>>
	<br><br>
<</widget>>

/*
│    ███████╗██╗   ██╗███████╗███╗   ██╗████████╗
│    ██╔════╝██║   ██║██╔════╝████╗  ██║╚══██╔══╝
│    █████╗  ██║   ██║█████╗  ██╔██╗ ██║   ██║
│    ██╔══╝  ╚██╗ ██╔╝██╔══╝  ██║╚██╗██║   ██║
│    ███████╗ ╚████╔╝ ███████╗██║ ╚████║   ██║
│    ╚══════╝  ╚═══╝  ╚══════╝╚═╝  ╚═══╝   ╚═╝
*/
<<widget "poppyFirstMeetingInit">>
	<<set $daily to $daily || {}>><<set $daily.poppy to $daily.poppy || {}>>
	<<if $poppySeen is undefined>>
		<<set $poppySeen to []>>
	<<elseif !Array.isArray($poppySeen)>>
		<<set $poppySeen_legacy to $poppySeen>>
		<<set $poppySeen to []>>
	<</if>>
	<<if typeof $poppyromance isnot "number">><<set $poppyromance to -1>><</if>>

	<<if C.npc.Poppy>>
		<<set _p to C.npc.Poppy>>
		<<set _p.init to 1>><<set _p.intro to 1>><<set _p.aware to 1>><<set _p.timer to _p.timer || {}>>
		<<if _p.timer.lastInteraction is undefined or _p.timer.lastInteraction is "">><<set _p.timer.lastInteraction to Time.date.timeStamp>><</if>>
		<<if _p.timer.lastPatienceDecay is undefined or _p.timer.lastPatienceDecay is "">><<set _p.timer.lastPatienceDecay to Time.date.timeStamp>><</if>>
		<<if typeof _p.patience isnot "number">><<set _p.patience to 80>><</if>>

		<<set _poppyIdx to -1>>
		<<if $npcrow isnot undefined and Array.isArray($npcrow)>><<set _poppyIdx to $npcrow.indexOf("Poppy")>><</if>>
		<<if _poppyIdx lt 0 and $NPCNameList isnot undefined and Array.isArray($NPCNameList)>><<set _poppyIdx to $NPCNameList.indexOf("Poppy")>><</if>>
		<<if _poppyIdx gte 0 and $NPCName isnot undefined and $NPCName[_poppyIdx] isnot undefined>>
			<<set $NPCName[_poppyIdx].intro to 1>>
			<<set $NPCName[_poppyIdx].name_known to 1>>
			<<set $NPCName[_poppyIdx].description to "Poppy">>
			<<set $NPCName[_poppyIdx].nam to "Poppy">>
		<</if>>

		<<if !$poppySeen.includes("talk_intro")>><<set $poppySeen.push("talk_intro")>><</if>>
		<<if !$poppySeen.includes("classroom_intro")>><<set $poppySeen.push("classroom_intro")>><</if>>
		<<run statusCheck("Poppy")>>
	<<else>>
		<<run console.warn("[Poppy intro] C.npc.Poppy is not available yet during first meeting. Intro init was skipped to avoid setting half-complete flags.")>>
	<</if>>

	<<set $opium_addiction to $opium_addiction ?? 0>>
	<<set $opium_timer to $opium_timer ?? 0>>
	<<set $opium_knowledge to $opium_knowledge ?? 0>>
	<<set $opium_message to $opium_message ?? "">>
	<<poppyPregnancy>>
<</widget>>

/*
	Poppy flat helpers
	- Keeps the flat chain self-contained
	- Mirrors the schedule idea from the design draft
*/
<<widget "poppyFlatInit">>
	/* ---- 1. Persistent containers ---- */
	<<set $daily to $daily || {}>>
	<<set $poppyFlat to $poppyFlat || {}>>
	<<set $daily.poppy to $daily.poppy || {}>>
	<<set $daily.poppy.flatMeals to $daily.poppy.flatMeals || {}>>
	<<set $daily.poppy.flatTending to $daily.poppy.flatTending || {}>>
	<<set $poppyFlat.windowRoom to $poppyFlat.windowRoom || "living_room">>
	<<if typeof $poppyFlat.kickedUntilDay isnot "number">><<set $poppyFlat.kickedUntilDay to -1>><</if>>
	<<if typeof $daily.poppy.flatBaileySeenDay isnot "number">><<set $daily.poppy.flatBaileySeenDay to -1>><</if>>
	<<if $poppySeen is undefined>>
		<<set $poppySeen to []>>
	<<elseif !Array.isArray($poppySeen)>>
		<<set $poppySeen_legacy to $poppySeen>>
		<<set $poppySeen to []>>
	<</if>>
	
	/* Reset transient per-entry fields */
	<<set $poppyFlat.home to false>>
	<<set $poppyFlat.room to "none">>
	<<set $poppyFlat.meal to "">>

	/* ---- 2. Refresh schedule + status ---- */
	<<run poppySchedule()>><<run statusCheck("Poppy")>>

	/* ---- 3. Map T.poppy_location -> $poppyFlat ---- */
	<<set _loc to T.poppy_location>>
	<<set _msg to T.poppy_location_message>>

	<<if _loc is "flatApartment">>
		<<set $poppyFlat.home to true>>
		<<if _msg is "sleep">>
			<<set $poppyFlat.room to "bedroom">>
		<<else>>
			/* "apartment" (blood moon / default) or "lounging" (weekend evenings) */
			<<set $poppyFlat.room to "living_room">>
		<</if>>
	<<elseif _loc is "flatKitchen">>
		<<set $poppyFlat.home to true>>
		<<set $poppyFlat.room to "kitchen">>
		<<set $poppyFlat.meal to (_msg is "breakfast" ? "breakfast" : "dinner")>>
	<<else>>
		/* Anywhere else (school, soup kitchen, lake, cafe, bailey office, nightly, nowhere)
		   means Poppy is not at the flat. */
		<<set $poppyFlat.home to false>>
		<<set $poppyFlat.room to "">>
		<<set $poppyFlat.meal to "">>
	<</if>>

	/* ---- 4. Bailey trigger flags ---- */
	<<set _rentDue to (Number($rentMoney) || 0) + (Number($babyRent) || 0)>>
	<<set _notYetToday to ($daily.poppy.flatBaileySeenDay isnot Time.days)>>
	/* Two-tier overdue: -2+ any time, or -1..0 only during waking hours (4-21). */
	<<set _rentOverdue to ($rentTime lte -2) or ($rentTime lte 0 and Time.hour gte 4 and Time.hour lte 21)>>
	<<set T.poppyFlatBaileyDue to !!(_rentOverdue and _notYetToday and _rentDue gt 0)>>
	<<set T.poppyFlatBaileyHome to $poppyFlat.home is true>>
	<<set T.poppyFlatBaileyLowPatience to !!(T.poppyStatus and T.poppyStatus.includes("LowPatience"))>>
<</widget>>
<<widget "poppyFlatContents">>
	<<if $bus isnot "poppy_living_room">><<poppyicon "living_room">><<link [[거실 (0:01)|Flats Poppy Living Room]]>><<pass 1>><</link>><br><</if>>
	<<if $bus isnot "poppy_kitchen">><<poppyicon "kitchen">><<link [[부엌 (0:01)|Flats Poppy Kitchen]]>><<pass 1>><</link>><br><</if>>
	<<if $bus isnot "poppy_bathroom">><<poppyicon "bathroom">><<link [[욕실 (0:01)|Flats Poppy Bathroom]]>><<pass 1>><</link>><br><</if>>
	<<if $bus isnot "poppy_bedroom">><<poppyicon "bed">><<link [[침실 (0:01)|Flats Poppy Bedroom]]>><<pass 1>><</link>><br><</if>>
	<<getouticon>><<link [[포피의 집에서 나간다|Flats]]>><<pass 1>><<endevent>><<set $eventskip to 0>><</link>>
<</widget>>

<<widget "poppyChristmasWrapOption">>
	<<if $christmas_wrap is 1 and $christmas_gift_poppy isnot undefined and $christmas_gift_poppy.endsWith("_unwrapped")>>
		<<set _poppyWrapRoom to ($bus or "").replace("poppy_", "")>>
		<<if !$poppyFlat.home or $poppyFlat.room isnot _poppyWrapRoom>>
			<<gifticon "wrapping">><<link [[포피의 선물을 포장한다 (0:10)|Flats Poppy Wrap Gift]]>><<pass 10>><<set $christmas_gift_poppy to $christmas_gift_poppy.replace("_unwrapped", "")>><<set $christmas_gift_poppy_wrapped to 1>><</link>>
			<br>
		<</if>>
	<</if>>
<</widget>>

/* Offers the one-per-bad-end heart to heart. _args[0] is "flat" or "lake". */
<<widget "poppyComfortOption">>
	<<if poppyBadEndComfortAvailable()>>
		<<socialiseicon>><<link [[포피에게 어디에 있었는지 이야기한다 (0:05)|Poppy Comfort Talk]]>><<pass 5>><<set $poppyComfortVenue to _args[0]>><<set $daily.poppy.lastAction to "chat">><</link>><<lstress>><<ltrauma>><<gpatience>>
		<br>
	<</if>>
<</widget>>

/* Shared passage header for the comfort talk, which runs at either venue. */
<<widget "poppyComfortHeader">>
	<<if $poppyComfortVenue is "lake">>
		<<effects>><<lakeeffects>>
	<<else>>
		<<set $location to "flats">><<set $bus to "poppy_living_room">><<set $outside to 0>><<effects>>
	<</if>>
	<<run poppySchedule()>>
<</widget>>


/* Menu */
<<widget "poppyLakeMenu">>
<<effects>><<lakeeffects>><<run poppySchedule()>><<run statusCheck("Poppy")>><<bodywritingExposureCheck>>
	<<set _poppyPostAction to ($eventskip is 1)>><<set _poppyFreshEntry to ($eventskip isnot 1)>>
	<<set _poppyLeaveNow to (!C.npc.Poppy or C.npc.Poppy.init isnot 1 or T.poppy_location isnot "lake" or Time.minutesSinceMidnight lt 540 or Time.minutesSinceMidnight gte 720 or Weather.precipitation is "rain" or Weather.precipitation is "snow")>>

	/* Fresh entry: direct scene injection is fine */
	<<if _poppyFreshEntry and _poppyLeaveNow>>
		<<include "Lake Poppy Departure">>
	<<elseif _poppyFreshEntry and $tiredness gte C.tiredness.max>>
		<<include "Lake Poppy Pass Out">>
	<<elseif _poppyFreshEntry and Number($poppyromance) gte 0 and !$poppySeen.includes("lake_postclaim_intro")>>
		<<include "Lake Poppy Invite Home">>
	<<elseif _poppyFreshEntry and Number($poppyromance) gte 0 and C.npc.Poppy.init is 1 and _bodywriting_exposed gte 1 and !$daily.poppy.bodywriting and _bodypart>>
		<<include "Poppy Bodywriting Reaction">>

	/* Post-action return: use Next links instead of include */
	<<elseif _poppyPostAction and _poppyLeaveNow>>
		포피가 <<his>> 손목시계를 힐끗 본다. "어머, 벌써 시간이 이렇게 됐네."
		<br><br>
		<<link [[다음|Lake Poppy Departure]]>><</link>>
	<<elseif _poppyPostAction and $tiredness gte C.tiredness.max>>
		갑작스러운 피로가 몰려온다.
		<br><br>
		<<link [[다음|Lake Poppy Pass Out]]>><</link>>
	<<elseif _poppyPostAction and !$daily.poppy.lakeNap and !$daily.poppy.forceNoNap and !T.poppyStatus.includes("LowPatience") and ($daily.poppy.lastAction is "chat" or $daily.poppy.lastAction is "flirt") and random(1,100) gte 82>>
		<<set $daily.poppy.lakeNap to true>>
		포피가 꽤 졸려 보인다.
		<br><br>
		<<link [[다음|Lake Poppy Doze]]>><</link>>
	<<else>>
		<<if _poppyFreshEntry>>
				<<if $awarelevel gte 5>>
					당신이 가까이 다가가자 포피의 귀가 씰룩인다.
					<br><br>
					<<if T.poppyStatus.includes("LowPatience")>>하지만 <<he>>【은는】 당신을 아는 체하지 않는다.<<else>><<He>>【은는】 당신 쪽으로 고개를 돌리며 미소 짓는다.<</if>> 당신은 포피 옆에 앉는다.
				<<else>>
					<<if T.poppyStatus.includes("LowPatience")>>포피는 당신을 아는 체하지 않는다.<<else>>포피가 당신 쪽으로 고개를 돌리며 미소 짓는다.<</if>>
					<br><br>
					당신은 포피 옆에 앉는다.
				<</if>>

				<<if !T.poppyStatus.includes("LowPatience") and !$poppySeen.includes("lake_meditation_intro") and !Weather.isFrozen("lake")>>
					<br><br>
					"자연의 아름다움을 즐기기에 완벽한 날씨야, 그렇지 않아?" 새끼 오리들을 거느린 오리 한 마리가 헤엄쳐 지나가자 <<His>> 미소가 더 커진다. "저 애는 내가 세이라고 이름 붙였어." <<He>>【은는】 강 건너편의 오리를 가리키며 웃는다.
					<<set $poppySeen.push("lake_meditation_intro")>>
				<</if>>
				<<poppyOpiumPulse>>
		<</if>>
		<<poppyComfortOption "lake">>
		<<socialiseicon>><<link [[포피와 대화한다 (0:15)|Lake Poppy Chat]]>><<pass 15>><<set $daily.poppy.lastAction to "chat">><</link>><<if T.poppyLoveGainAllowed>><<glove>><</if>><<gpatience>>
		<br>
		<<if (npcIsPregnant("Poppy") and knowsAboutPregnancy("Poppy", "pc")) or (playerIsPregnant() and playerAwareTheyArePregnant() and knowsAboutPregnancy("pc", "Poppy"))>>
			<<if playerIsPregnant() and playerAwareTheyArePregnant() and knowsAboutPregnancy("pc", "Poppy")>><<pregnancyicon "player">><<else>><<pregnancyicon "Poppy">><</if>><<link [[임신에 대해 이야기한다 (0:15)|Poppy Pregnancy Chat]]>><<pass 15>><<set $daily.poppy.lastAction to "chat">><</link>><<if T.poppyLoveGainAllowed>><<glove>><</if>>
			<br>
		<</if>>
		<<socialiseicon>><<link [[추파를 던진다 (0:15)|Lake Poppy Flirt]]>><<pass 15>><<set $daily.poppy.lastAction to "flirt">><</link>><<promiscuous1>><<if T.poppyLoveGainAllowed>><<glove>><</if>><<if Number($poppyromance) gte 0 and !T.poppyStatus.includes("LowPatience")>><<glust>><</if>>
		<br>
		<<if $wolfgirl gte 6 or ($transformationParts.wolf.tail isnot "hidden" and $transformationParts.wolf.tail isnot "disabled")>>
			<<tficon "wolf">><<link [[울부짖는다 (0:20)|Lake Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "wolf">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<gpatience>>
			<br>
		<<elseif $fox gte 6 or ($transformationParts.fox.tail isnot "hidden" and $transformationParts.fox.tail isnot "disabled")>>
			<<tficon "fox">><<link [[캥캥 짖는다 (0:20)|Lake Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "fox">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<gpatience>>
			<br>
		<<elseif $cow gte 6 or ($transformationParts.cow.tail isnot "hidden" and $transformationParts.cow.tail isnot "disabled")>>
			<<tficon "cow">><<link [[살며시 머리를 들이받는다 (0:20)|Lake Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "cow">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<gpatience>>
			<br>
		<<elseif $harpy gte 6 or ($transformationParts.bird.wings isnot "hidden" and $transformationParts.bird.wings isnot "disabled")>>
			<<birdicon "sing">><<link [[노래한다 (0:20)|Lake Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "harpy">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<gpatience>>
			<br>
		<<elseif $cat gte 6 or ($transformationParts.cat.tail isnot "hidden" and $transformationParts.cat.tail isnot "disabled")>>
			<<tficon "cat">><<link [[얼굴을 비빈다 (0:20)|Lake Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "cat">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<gpatience>>
			<br>
		<<elseif $bear gte 6 or ($transformationParts.bear.tail isnot "hidden" and $transformationParts.bear.tail isnot "disabled")>>
			<<tficon "bear">><<link [[기댄다 (0:20)|Lake Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "bear">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<gpatience>>
			<br>
		<<elseif $bunny gte 6 or ($transformationParts.bunny.tail isnot "hidden" and $transformationParts.bunny.tail isnot "disabled")>>
			<<tficon "bunny">><<link [[머리를 들이받는다 (0:20)|Lake Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "bunny">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<gpatience>>
			<br>
		<</if>>
		<<poppyChristmasGiftOption "lake">>
		<<if T.poppyStatus.includes("LowPatience") and canGiftFood("Poppy")>>
			<<skinicon "give">><span class="black">선물을 준다</span> | <span class="red">포피는 지금 너무 짜증이 나서 아무것도 받아 주지 않는다.</span>
		<<elseif canGiftFood("Poppy")>>
			<<skinicon "give">><<link [[선물을 준다|Poppy Lake Gifts List]]>><<set $daily.poppy.lastAction to "gift">><</link>>
		<</if>>
		<br>
		<<getouticon>><<link [[떠난다|Lake Shore]]>><<endevent>><<set $eventskip to 0>><</link>>
	<</if>>
<</widget>>
<<widget "poppyLakeReturn">>
	<<run poppySchedule()>><<run statusCheck("Poppy")>>
	<<if !C.npc.Poppy or C.npc.Poppy.init isnot 1 or T.poppy_location isnot "lake" or Time.minutesSinceMidnight lt 540 or Time.minutesSinceMidnight gte 720 or Weather.precipitation is "rain" or Weather.precipitation is "snow">>
		포피가 <<his>> 손목시계를 힐끗 본다. "어머, 벌써 시간이 이렇게 됐네."
		<br><br>
		<<link [[다음|Lake Poppy Departure]]>><<set $eventskip to 0>><</link>>
	<<else>>
		<<set $eventskip to 1>>
		<<poppyLakeMenu>>
	<</if>>
<</widget>>

<<widget "poppyFlatsMenu">>
<<set $bus to "poppy_living_room">><<effects>><<run poppySchedule()>><<bodywritingExposureCheck>>
	<<set _poppyPostAction to ($eventskip is 1)>><<set _poppyFreshEntry to ($eventskip isnot 1)>>
	<<set _poppyLeaveNow to (!C.npc.Poppy or C.npc.Poppy.init isnot 1 or !$poppyFlat.home or $poppyFlat.room isnot "living_room")>>

	/* Fresh entry: direct scene injection is fine */
	<<if _poppyFreshEntry and _poppyLeaveNow>>
		<<include "Flats Poppy Departure">>
	<<elseif _poppyFreshEntry and $tiredness gte C.tiredness.max>>
		<<include "Flats Poppy Pass Out">>
	<<elseif _poppyFreshEntry and Number($poppyromance) gte 0 and C.npc.Poppy.init is 1 and _bodywriting_exposed gte 1 and !$daily.poppy.bodywriting and _bodypart>>
		<<include "Flats Poppy Bodywriting Reaction">>

	/* Post-action return: use Next links instead of include */
	<<elseif _poppyPostAction and _poppyLeaveNow>>
		포피가 <<his>> 손목시계를 힐끗 본다. "어머, 벌써 시간이 이렇게 됐네."
		<br><br>
		<<link [[다음|Flats Poppy Departure]]>><</link>>
	<<elseif _poppyPostAction and $tiredness gte C.tiredness.max>>
		갑작스러운 피로가 몰려온다.
		<br><br>
		<<link [[다음|Flats Poppy Pass Out]]>><</link>>
	<<elseif _poppyPostAction and !$daily.poppy.flatsNap and !$daily.poppy.forceNoNap and !T.poppyStatus.includes("LowPatience") and ($daily.poppy.lastAction is "chat" or $daily.poppy.lastAction is "flirt") and random(1,100) gte 82>>
		<<set $daily.poppy.flatsNap to true>>
		포피가 꽤 졸려 보인다.
		<br><br>
		<<link [[다음|Flats Poppy Doze]]>><</link>>
	<<else>>
		<<if _poppyFreshEntry>>
				<<if $awarelevel gte 5>>
					<<if T.poppyStatus and T.poppyStatus.includes("LowPatience")>>
						당신이 가까이 다가가자 포피의 여우 귀가 씰룩인다. 당신이 포피 옆에 앉자 쿠션이 푹 꺼진다. <<He>>【은는】 당신을 아는 체하지 않는다.
					<<else>>
						당신이 가까이 다가가자 포피의 여우 귀가 씰룩인다. <<He>>【은는】 당신 쪽으로 고개를 돌리며 미소 짓는다. 당신이 포피 옆에 앉자 쿠션이 푹 꺼진다.
					<</if>>
				<<else>>
					<<if T.poppyStatus and T.poppyStatus.includes("LowPatience")>>
						당신이 포피 옆에 앉자 쿠션이 푹 꺼진다. <<He>>【은는】 당신을 아는 체하지 않는다.
					<<else>>
						<<He>>【은는】 당신 쪽으로 고개를 돌리며 미소 짓는다. 당신이 포피 옆에 앉자 쿠션이 푹 꺼진다.
					<</if>>
				<</if>>
			<<poppyOpiumPulse>>
		<</if>>
		<<if playerAwareTheyArePregnant()>>
			<<if C.npc.Poppy.pregnancy.test is true>>
				/* PC came back with paternity proof */
				<<procedureicon "paternity">><<link [[포피에게 친자 확인 결과를 보여 준다 (0:05)|Poppy Pregnancy Reveal]]>><<pass 5>><</link>>
				<br>
			<<elseif !knowsAboutPregnancy("pc", "Poppy")>>
				/* PC has never told Poppy; show whatever PC has */
				<<set _pregnancy to getPlayerPregnancy()>>
				<<if _pregnancy?.ultrasoundDone and C.npc.Poppy.pregnancy.ultraSound is "requested">>
					/* Poppy already saw the test once and asked for proof */
					<<pregnancyicon "player">><<link [[포피에게 초음파 사진을 보여 준다 (0:05)|Poppy Pregnancy Reveal]]>>
						<<set C.npc.Poppy.pregnancy.ultraSound to "collected">><<pass 5>>
					<</link>>
					<br>
				<<elseif _pregnancy?.ultrasoundDone>>
					/* PC has both test and ultrasound in hand, combined reveal */
					<<pregnancyicon "player">><<link [[포피에게 임신 테스트기와 초음파 사진을 보여 준다 (0:05)|Poppy Pregnancy Reveal]]>>
						<<set C.npc.Poppy.pregnancy.ultraSound to "collected">><<pass 5>>
					<</link>>
					<br>
				<<else>>
					/* PC only has the test */
					<<if !V.player.vaginaExist>>
						<<pregnancytesticon>><<link [[포피에게 임신 테스트기를 보여 준다 (0:05)|Poppy Pregnancy Reveal Mpreg Alt]]>>
							<<pass 5>>
						<</link>>
					<<else>>
						<<pregnancytesticon>><<link [[포피에게 임신 테스트기를 보여 준다 (0:05)|Poppy Pregnancy Reveal]]>>
							<<pass 5>>
						<</link>>
					<</if>>
					<br>
				<</if>>
			<br>
			<</if>>
		<</if>>
		<<poppyComfortOption "flat">>
		<<if !$poppySeen.includes("flat_chat_plant") and Number($poppyromance) gte 0>>
			<<socialiseicon>><<link [[대화한다 (0:15)|Flats Poppy Chat Plant]]>><<pass 15>><<set $daily.poppy.lastAction to "chat">><</link>><<if T.poppyLoveGainAllowed>><<glove>><</if>><<gpatience>>
			<br>
		<<else>>
			<<socialiseicon>><<link [[대화한다 (0:15)|Flats Poppy Chat]]>><<pass 15>><<set $daily.poppy.lastAction to "chat">><</link>><<if T.poppyLoveGainAllowed>><<glove>><</if>><<gpatience>>
			<br>
		<</if>>
		<<if (npcIsPregnant("Poppy") and knowsAboutPregnancy("Poppy", "pc")) or (playerIsPregnant() and playerAwareTheyArePregnant() and knowsAboutPregnancy("pc", "Poppy"))>>
			<<if playerIsPregnant() and playerAwareTheyArePregnant() and knowsAboutPregnancy("pc", "Poppy")>><<pregnancyicon "player">><<else>><<pregnancyicon "Poppy">><</if>><<link [[임신에 대해 이야기한다 (0:15)|Poppy Pregnancy Chat]]>><<pass 15>><<set $daily.poppy.lastAction to "chat">><</link>><<if T.poppyLoveGainAllowed>><<glove>><</if>>
			<br>
		<</if>>
		<<socialiseicon>><<link [[추파를 던진다 (0:15)|Flats Poppy Flirt]]>><<pass 15>><<set $daily.poppy.lastAction to "flirt">><</link>><<promiscuous1>><<if T.poppyLoveGainAllowed>><<glove>><</if>><<if Number($poppyromance) gte 0 and !T.poppyStatus.includes("LowPatience")>><<glust>><</if>>
		<br>
		<<if $wolfgirl gte 6 or ($transformationParts.wolf.tail isnot "hidden" and $transformationParts.wolf.tail isnot "disabled")>>
			<<tficon "wolf">><<link [[울부짖는다 (0:20)|Flats Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "wolf">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<gpatience>>
			<br>
		<<elseif $fox gte 6 or ($transformationParts.fox.tail isnot "hidden" and $transformationParts.fox.tail isnot "disabled")>>
			<<tficon "fox">><<link [[캥캥 짖는다 (0:20)|Flats Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "fox">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<gpatience>>
			<br>
		<<elseif $cow gte 6 or ($transformationParts.cow.tail isnot "hidden" and $transformationParts.cow.tail isnot "disabled")>>
			<<tficon "cow">><<link [[살며시 머리를 들이받는다 (0:20)|Flats Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "cow">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<gpatience>>
			<br>
		<<elseif $harpy gte 6 or ($transformationParts.bird.wings isnot "hidden" and $transformationParts.bird.wings isnot "disabled")>>
			<<birdicon "sing">><<link [[노래한다 (0:20)|Flats Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "harpy">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<gpatience>>
			<br>
		<<elseif $cat gte 6 or ($transformationParts.cat.tail isnot "hidden" and $transformationParts.cat.tail isnot "disabled")>>
			<<tficon "cat">><<link [[얼굴을 비빈다 (0:20)|Flats Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "cat">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<gpatience>>
			<br>
		<<elseif $bear gte 6 or ($transformationParts.bear.tail isnot "hidden" and $transformationParts.bear.tail isnot "disabled")>>
			<<tficon "bear">><<link [[기댄다 (0:20)|Flats Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "bear">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<gpatience>>
			<br>
		<<elseif $bunny gte 6 or ($transformationParts.bunny.tail isnot "hidden" and $transformationParts.bunny.tail isnot "disabled")>>
			<<tficon "bunny">><<link [[머리를 들이받는다 (0:20)|Flats Poppy TF]]>><<pass 20>><<set $daily.poppy.lastAction to "tf">><<set $daily.poppy.lastTFType to "bunny">><</link>>
			<<if T.poppyLoveGainAllowed>><<glove>><</if>><<ltrauma>><<lstress>><<gpatience>>
			<br>
		<</if>>
		<<poppyChristmasGiftOption "flat">>
		<<if T.poppyStatus.includes("LowPatience") and canGiftFood("Poppy")>>
			<<skinicon "give">><span class="black">선물을 준다</span> | <span class="red">포피는 지금 너무 짜증이 나서 아무것도 받아 주지 않는다.</span>
		<<elseif canGiftFood("Poppy")>>
			<<skinicon "give">><<link [[선물을 준다|Flats Poppy Gift List]]>><<set $daily.poppy.lastAction to "gift">><</link>>
		<</if>>
		<br>
		<<getouticon>><<link [[떠난다|Flats Poppy Living Room]]>><<set $eventskip to 0>><</link>>
	<</if>>
<</widget>>

<<widget "poppyChristmasGiftOption">>
	<<if $christmas is 1 and $christmas_gift_poppy_wrapped is 1 and $christmas_gift_poppy_given is undefined>>
		<<if _args[0] is "lake">>
			<<gifticon "love">><<link [[포피에게 크리스마스 선물을 준다 (0:10)|Poppy Christmas Gift]]>><<pass 10>><<set $daily.poppy.lastAction to "gift">><<set $poppyGiftVenue to "lake">><</link>>
		<<else>>
			포피가 크리스마스 장식을 매만지고 있는 것이 보인다.
			<br><br>
			<<gifticon "love">><<link [[포피에게 크리스마스 선물을 준다 (0:10)|Poppy Christmas Gift]]>><<pass 10>><<set $daily.poppy.lastAction to "gift">><<set $poppyGiftVenue to "flat">><</link>>
		<</if>>
		<br>
	<</if>>
<</widget>>

<<widget "poppyChristmasTuxedoOpener">>
	<<if C.npc.Poppy.pronoun is "f">>
		포피는 정장을 보고 잠시 멈칫한다. <<He>>【은는】 잠깐 당신을 올려다보더니 씩 웃는다. "내가 정장 입은 모습이 보고 싶었으면 그냥 말하지 그랬어." 포피가 정장을 들어 올려 이리저리 흔든다.
	<<else>>
		"와, 대박! 이거 비쌌겠는데, 그렇지?" 포피가 정장의 천을 손으로 만져 본다. <<his>> 얼굴에 미소가 슬며시 번지기 시작한다.
	<</if>>
	<br><br>
<</widget>>

<<widget "poppyChristmasGiftReturn">>
	<<if poppyGiftAtFlat()>>
		<<set $eventskip to 1>>
		<<poppyFlatsMenu>>
	<<else>>
		<<poppyLakeReturn>>
	<</if>>
	<<unset $poppyGiftVenue>>
<</widget>>

<<widget "poppyChristmasBaileyPayment">>
	당신이 포피와 이야기하는 동안, <<his>> 뒤로 베일리 사무실의 문이 열리고 포피가 선물한 과자 때문에 일어난 소란을 살피러 베일리가 나오는 것이 보인다. <<nnpc_He "Bailey">>【은는】 기분이 좋아 보이지 않는다.
	<br><br>
	포피가 당신이 <<his>> 어깨 너머를 보고 있다는 것을 알아채고 돌아서서 베일리를 본다. <<He>>【은는】 손에 무언가를 든 채 베일리에게 다가간다.
	<br><br>
	<<if currentSkillValue('skulduggery') gte 200>>
		<span class="teal">도둑의 눈으로 보면 남들이 놓치는 것이 보인다.</span> 포피가 베일리에게 작은 현금 뭉치를 건네고 있다.
		<br><br>
	<<elseif hasSharpSenses("sight") or hasSharpSenses("instincts")>>
		당신의 <span class="green">날카로운 눈</span>이 포피의 손가락 움직임을 포착한다. <<He>>【은는】 베일리에게 작은 현금 뭉치를 건네고 있다.
		<br><br>
	<<else>>
		포피가 다가가자 베일리의 표정이 바뀐다. 포피가 무슨 말을 하든 너무 작아서 들리지 않는다.
		<br><br>
	<</if>>
	베일리가 그것을 받아 <<nnpc_his "Bailey">> 고개를 끄덕인다. <<nnpc_He "Bailey">>【은는】 소란에서 벗어나려는 듯 고아원 밖으로 나간다.
<</widget>>
